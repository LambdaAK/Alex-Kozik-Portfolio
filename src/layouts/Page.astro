---
// A site page: frosted top bar (name, page links, theme), then one readable column with an
// optional small section label, like the original one-page version.
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile, nav } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  /** Nav item to mark as current, by href. */
  current?: string;
  /** Small label above the content, e.g. "Experience". */
  heading?: string;
}
const { current, heading, ...rest } = Astro.props;
---

<BaseLayout {...rest}>
  <header class="sticky top-0 z-40 border-b border-line/60 bg-bg">
    <div class="mx-auto flex h-12 max-w-[44rem] items-center gap-6 px-5 text-sm">
      <a href="/" class="t-title group shrink-0 font-display"><span class="spark mr-1" aria-hidden="true">✻</span>{profile.name.toLowerCase()}</a>
      <nav class="flex min-w-0 flex-1 gap-x-5 overflow-x-auto py-2 text-fg-faint [scrollbar-width:none]" aria-label="Pages">
        {
          nav.map((n) => (
            <a href={n.href} class="relative shrink-0 transition hover:text-accent aria-[current=page]:text-fg aria-[current=page]:after:absolute aria-[current=page]:after:-bottom-1.5 aria-[current=page]:after:left-1/2 aria-[current=page]:after:h-1 aria-[current=page]:after:w-1 aria-[current=page]:after:-translate-x-1/2 aria-[current=page]:after:rounded-full aria-[current=page]:after:bg-accent" aria-current={n.href === current ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <main id="main" class="mx-auto max-w-[44rem] px-5 pt-14 pb-24 sm:pt-20">
    {heading && <h1 class="t-page mb-8">{heading}<span class="text-accent">.</span></h1>}
    <slot />
  </main>
</BaseLayout>
