---
// A site page: frosted top bar (name, page links, theme), then one readable column with an
// optional small section label, like the original one-page version.
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile, nav } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  field?: boolean;
  /** Nav item to mark as current, by href. */
  current?: string;
  /** Small label above the content, e.g. "Experience". */
  heading?: string;
}
const { current, heading, ...rest } = Astro.props;
---

<BaseLayout {...rest}>
  <header class="sticky top-0 z-40 bg-bg/80 backdrop-blur-md">
    <div class="mx-auto flex h-12 max-w-[44rem] items-center gap-6 px-5 text-sm">
      <a href="/" class="shrink-0 font-medium">{profile.name.toLowerCase()}</a>
      <nav class="flex min-w-0 flex-1 gap-x-5 overflow-x-auto text-fg-faint [scrollbar-width:none]" aria-label="Pages">
        {
          nav.map((n) => (
            <a href={n.href} class="shrink-0 transition hover:text-fg aria-[current=page]:text-fg" aria-current={n.href === current ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <main id="main" class="mx-auto max-w-[44rem] px-5 pt-14 pb-24 sm:pt-20">
    {heading && <h1 class="mb-6 text-[15px] font-medium text-fg-faint">{heading}</h1>}
    <slot />
  </main>
</BaseLayout>
