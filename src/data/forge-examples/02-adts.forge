// Algebraic data types + pattern matching: a tiny expression evaluator.
type rec Expr =
  | Num of Int
  | Add of (Expr, Expr)
  | Mul of (Expr, Expr)
  | Neg of Expr

let rec eval e =
  case e do
  | Num n -> n
  | Add (a, b) -> eval a + eval b
  | Mul (a, b) -> eval a * eval b
  | Neg a -> 0 - eval a

let rec show_expr e =
  case e do
  | Num n -> int_to_str n
  | Add (a, b) -> str_concat (str_concat (str_concat "(" (show_expr a)) " + ") (str_concat (show_expr b) ")")
  | Mul (a, b) -> str_concat (str_concat (show_expr a) " * ") (show_expr b)
  | Neg a -> str_concat "-" (show_expr a)

let e = Mul (Add (Num 2, Num 3), Neg (Num 4))
let () = print_string (show_expr e)
let () = println (eval e)
