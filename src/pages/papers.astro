---
import Page from '../layouts/Page.astro';
import { profile } from '../data/profile';
import { papers } from '../data/papers';
---

<Page current="/papers/" heading="Papers" title={`Papers – ${profile.name}`} path="/papers/">
  <ul class="space-y-6">
    {
      papers.map((p) => (
        <li>
          <a href={p.pdf} class="ink font-medium" target="_blank" rel="noopener" data-umami-event="report" data-umami-event-project={p.title}>
            {p.title}
          </a>
          <p class="mt-0.5 text-sm text-fg-faint">{p.venue}</p>
          <p class="mt-2 leading-relaxed text-fg-muted">{p.summary}</p>
          <p class="mt-2 flex flex-wrap gap-x-5 text-sm">
            <a href={p.pdf} class="ink" target="_blank" rel="noopener">pdf</a>
            {p.code && (
              <a href={p.code} class="ink" target="_blank" rel="noopener">
                code
              </a>
            )}
            {p.project && (
              <a href={p.project} class="ink">
                project
              </a>
            )}
          </p>
        </li>
      ))
    }
  </ul>
</Page>
