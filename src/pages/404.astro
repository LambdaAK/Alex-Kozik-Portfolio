  <p class="t-sub mt-5 flex flex-wrap gap-x-4 gap-y-1">
    <a href="/" class="ink">about</a>
    <a href="/projects/" class="ink">projects</a>
    <a href="/experience/" class="ink">experience</a>
  </p>
</Page>
