---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Section from '../components/Section.astro';
import Timeline from '../components/Timeline.astro';
import { profile, nav } from '../data/profile';
import { experience } from '../data/experience';
import { education } from '../data/education';
import { awards } from '../data/awards';
import { papers } from '../data/papers';
import { demos } from '../data/demos';
import portrait from '../assets/alex.jpeg';

const all = await getCollection('projects');
const featured = all.filter((p) => p.data.group === 'featured').sort((a, b) => a.data.order - b.data.order);

// A few more one-liners; everything else lives on /projects.
const MORE = ['c-torch', 'dx', 'mnist-classifier', 'snake-dqn', 'text2code', 'english2logic', 'sasylf', 'obsidiandb'];
const more = (await Promise.all(MORE.map((id) => getEntry('projects', id)))).filter((p) => p !== undefined);

const contact = [
  { href: profile.resume, label: 'résumé', event: 'resume' },
  { href: profile.linkedin, label: 'linkedin', event: 'linkedin' },
  { href: `mailto:${profile.email}`, label: 'email', event: 'email' },
  { href: profile.github, label: 'github', event: 'github' },
];
const ext = (href: string) => (href.startsWith('http') || href.endsWith('.pdf') ? { target: '_blank', rel: 'noopener' } : {});
---

<BaseLayout>
  <header class="sticky top-0 z-40 bg-bg/80 backdrop-blur-md">
    <div class="mx-auto flex h-12 max-w-[40rem] items-center gap-5 px-5 text-sm">
      <a href="#about" class="shrink-0 font-medium">alex kozik</a>
      <nav class="flex min-w-0 flex-1 gap-x-4 overflow-x-auto text-fg-faint [scrollbar-width:none]" aria-label="Sections">
        {
          nav.map((n) => (
            <a href={`#${n.id}`} data-nav={n.id} class="shrink-0 transition hover:text-fg aria-[current=true]:text-fg">
              {n.label.toLowerCase()}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <main id="main" class="mx-auto max-w-[40rem] px-5 pb-24">
    <section id="about" class="scroll-mt-16 pt-16 sm:pt-24">
      <Image src={portrait} alt="Alex Kozik" width={128} height={128} class="h-14 w-14 rounded-full object-cover" loading="eager" />
      <h1 class="mt-5 text-2xl font-semibold tracking-[-0.02em]">Alex Kozik</h1>
      <p class="mt-3 leading-relaxed text-fg-muted">
        hi. I'm a master's student at Carnegie Mellon, working on reinforcement learning in Andrea Zanette's group. before that:
        Cornell, Amazon, Salesforce.
      </p>
      <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {
          contact.map((c) => (
            <a href={c.href} class="ink" data-umami-event={c.event} {...ext(c.href)}>
              {c.label}
            </a>
          ))
        }
      </p>
    </section>

    <Section id="education" title="education">
      <ol class="space-y-7">
        {
          education.map((e) => (
            <li class="flex gap-4">
              <Image src={e.logo} alt="" width={80} height={80} class="mt-1 h-9 w-9 shrink-0 rounded-lg bg-white object-contain p-1 ring-1 ring-black/5" />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <p class="font-medium">
                    {e.degree}{' '}
                    <span class="font-normal text-fg-muted">
                      at{' '}
                      <a href={e.url} class="ink" target="_blank" rel="noopener">
                        {e.school}
                      </a>
                    </span>
                  </p>
                  <span class="text-sm text-fg-faint">{e.dates}</span>
                </div>
                <p class="mt-1 leading-relaxed text-fg-muted">
                  {[e.detail, ...e.notes].join(' · ')}
                </p>
                <details class="group mt-1">
                  <summary class="more cursor-pointer list-none text-sm hover:text-fg">
                    <span class="group-open:hidden">coursework</span>
                    <span class="hidden group-open:inline">hide coursework</span>
                  </summary>
                  <p class="mt-1.5 text-sm leading-relaxed text-fg-muted">{e.courses.flatMap((c) => c.items).join(' · ')}</p>
                </details>
              </div>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="experience" title="experience">
      <Timeline items={experience.filter((e) => !e.research)} />
    </Section>

    <Section id="research" title="research">
      <Timeline items={experience.filter((e) => e.research)} />
    </Section>

    <Section id="awards" title="awards">
      <ul class="space-y-3">
        {
          awards.map((a) => (
            <li class="flex items-baseline justify-between gap-4">
              <p>
                {a.title}
                <span class="text-fg-muted"> · {a.org}</span>
              </p>
              <span class="shrink-0 text-sm text-fg-faint">{a.year}</span>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="papers" title="papers">
      <ul class="space-y-4">
        {
          papers.map((p) => (
            <li>
              <a href={p.pdf} class="ink" target="_blank" rel="noopener" data-umami-event="report" data-umami-event-project={p.title}>
                {p.title}
              </a>
              <p class="text-sm text-fg-faint">{p.venue}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="projects" title="projects">
      <ul class="space-y-6">
        {
          featured.map((p) => {
            const r = p.data.results[0];
            return (
              <li>
                <div class="flex items-baseline justify-between gap-4">
                  <p>
                    <a href={`/projects/${p.id}/`} class="ink font-medium" data-umami-event="project-open" data-umami-event-project={p.data.title}>
                      {p.data.title}
                    </a>
                    {demos[p.id] && (
                      <a href={`/projects/${p.id}/#demo`} class="ml-2 text-sm text-fg-faint hover:text-fg">
                        {demos[p.id]} →
                      </a>
                    )}
                  </p>
                  <span class="shrink-0 text-sm text-fg-faint">{p.data.date}</span>
                </div>
                <p class="mt-1 leading-relaxed text-fg-muted">{p.data.question ?? p.data.description}</p>
                {r && (
                  <p class="mt-0.5 text-sm text-fg-faint">
                    {r.value} · {r.metric}
                  </p>
                )}
              </li>
            );
          })
        }
      </ul>

      <p class="mt-10 text-[15px] font-medium text-fg-faint">also</p>
      <ul class="mt-3 space-y-2.5">
        {
          more.map((p) => (
            <li class="flex items-baseline justify-between gap-4">
              <p class="min-w-0">
                <a href={`/projects/${p.id}/`} class="ink">
                  {p.data.title}
                </a>
                {(demos[p.id] || p.data.demo) && <span class="text-sm text-fg-faint"> · live</span>}
              </p>
              <span class="shrink-0 text-sm text-fg-faint">{p.data.date}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6">
        <a href="/projects/" class="ink text-fg-muted">everything ({all.length}) →</a>
      </p>
    </Section>
  </main>

  <script>
    // Highlight the nav link for the section in view.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav]'));
    const sections = links.map((l) => document.getElementById(l.dataset.nav!)).filter((s): s is HTMLElement => !!s);
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.nav === visible.target.id)));
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: [0, 0.25, 0.5] },
    );
    sections.forEach((s) => spy.observe(s));
  </script>
</BaseLayout>
