---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import Section from '../components/Section.astro';
import Logo from '../components/Logo.astro';
import CourseList from '../components/CourseList.astro';
import { profile } from '../data/profile';
import { education } from '../data/education';
import { awards } from '../data/awards';
import portrait from '../assets/alex.jpeg';

const contact = [
  { href: profile.resume, label: 'résumé', event: 'resume' },
  { href: profile.linkedin, label: 'linkedin', event: 'linkedin' },
  { href: `mailto:${profile.email}`, label: 'email', event: 'email' },
  { href: profile.github, label: 'github', event: 'github' },
];
const ext = (href: string) => (href.startsWith('http') || href.endsWith('.pdf') ? { target: '_blank', rel: 'noopener' } : {});
---

<Page current="/" field>
  <section aria-label="About">
    <Image src={portrait} alt="Alex Kozik" width={160} height={160} class="h-16 w-16 rounded-full object-cover" loading="eager" />
    <div class="mt-8 space-y-6 text-xl leading-snug sm:text-2xl">
      <p>I study computer science at Carnegie Mellon.</p>
      <p>I'm interested in reinforcement learning and the systems that make machine learning fast.</p>
      <p>Before CMU, I studied at Cornell and interned at Amazon and Salesforce.</p>
      <p>I enjoy teaching, working out, and reading.</p>
    </div>
    <p class="mt-8 flex flex-wrap gap-x-5 gap-y-1">
      {
        contact.map((c) => (
          <a href={c.href} class="ink" data-umami-event={c.event} {...ext(c.href)}>
            {c.label}
          </a>
        ))
      }
    </p>
  </section>

  <div class="mt-10">
    <Section id="education" title="Education">
      <ol class="space-y-7">
        {
          education.map((e) => (
            <li class="flex gap-5">
              <Logo src={e.logo} tile={e.logoTile} />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <p class="font-medium">
                    {e.degree}{' '}
                    <span class="font-normal text-fg-muted">
                      at{' '}
                      <a href={e.url} class="ink" target="_blank" rel="noopener">
                        {e.school}
                      </a>
                    </span>
                  </p>
                  <span class="text-sm text-fg-faint">{e.dates}</span>
                </div>
                <p class="mt-1 leading-relaxed text-fg-muted">{[e.detail, ...e.notes].join(' · ')}</p>
                <details class="group mt-1">
                  <summary class="more cursor-pointer list-none text-sm hover:text-fg">
                    <span class="group-open:hidden">coursework</span>
                    <span class="hidden group-open:inline">hide coursework</span>
                  </summary>
                  <div class="mt-3 space-y-4">
                    {e.courses.map((g) => (
                      <div>
                        {e.courses.length > 1 && <p class="mb-1.5 text-xs font-medium text-fg-faint">{g.group.toLowerCase()}</p>}
                        <CourseList items={g.items} />
                      </div>
                    ))}
                  </div>
                </details>
              </div>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="awards" title="Awards">
      <ul class="space-y-3">
        {
          awards.map((a) => (
            <li class="flex items-baseline justify-between gap-4">
              <p>
                {a.title}
                <span class="text-fg-muted"> · {a.org}</span>
              </p>
              <span class="shrink-0 text-sm text-fg-faint">{a.year}</span>
            </li>
          ))
        }
      </ul>
    </Section>
  </div>
</Page>
