---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechChips from '../components/TechChips.astro';
import { profile, nav } from '../data/profile';
import { experience } from '../data/experience';
import { education } from '../data/education';
import { awards } from '../data/awards';
import { papers } from '../data/papers';
import portrait from '../assets/alex.jpeg';

const all = await getCollection('projects');
const byGroup = (g: 'featured' | 'ml' | 'swe') =>
  all.filter((p) => p.data.group === g).sort((a, b) => a.data.order - b.data.order);
const featured = byGroup('featured');
const ml = byGroup('ml');
const swe = byGroup('swe');

const socials = [
  { href: profile.github, label: 'GitHub', icon: 'github' },
  { href: profile.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: `mailto:${profile.email}`, label: 'Email', icon: 'mail' },
] as const;
---

<BaseLayout>
  <div class="mx-auto max-w-6xl px-6 lg:flex lg:gap-12 lg:px-12 xl:gap-20">
    <!-- Sidebar / hero -->
    <aside class="flex flex-col pt-12 lg:sticky lg:top-0 lg:h-screen lg:w-[38%] lg:shrink-0 lg:overflow-y-auto lg:py-16">
      <div class="flex items-start justify-between gap-4">
        <Image
          src={portrait}
          alt="Alex Kozik"
          width={224}
          height={224}
          class="h-20 w-20 rounded-full object-cover ring-2 ring-line lg:h-24 lg:w-24"
          loading="eager"
        />
        <ThemeToggle />
      </div>

      <h1 class="mt-6 text-3xl font-bold tracking-tight lg:text-4xl">{profile.name}</h1>
      <p class="mt-2 text-lg font-medium text-fg">{profile.tagline}</p>

      <div class="mt-5 space-y-3 text-sm leading-relaxed text-fg-muted">
        {profile.bio.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        <a
          href={profile.resume}
          class="inline-flex items-center gap-2 rounded-full bg-fg px-4 py-2 text-sm font-semibold text-bg transition hover:opacity-85"
          target="_blank"
          rel="noopener"
        >
          <Icon name="file" /> Résumé
        </a>
        {
          socials.map((s) => (
            <a
              href={s.href}
              class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm font-medium text-fg-muted transition hover:border-accent hover:text-fg"
              target={s.href.startsWith('mailto:') ? undefined : '_blank'}
              rel="noopener"
            >
              <Icon name={s.icon} /> {s.label}
            </a>
          ))
        }
      </div>

      <nav class="mt-10 hidden lg:block" aria-label="Sections">
        <ul class="space-y-3">
          {
            nav.map((n) => (
              <li>
                <a
                  href={`#${n.id}`}
                  data-nav={n.id}
                  class="group flex items-center gap-3 text-xs font-semibold tracking-[0.18em] text-fg-faint uppercase transition hover:text-fg aria-[current=true]:text-fg"
                >
                  <span class="h-px w-6 bg-fg-faint transition-all group-hover:w-12 group-hover:bg-fg group-aria-[current=true]:w-12 group-aria-[current=true]:bg-fg" />
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="mt-auto hidden pt-10 text-xs text-fg-faint lg:block">
        {profile.location} · <a href={profile.github + '/Alex-Kozik-Portfolio'} class="hover:text-fg">Source</a>
      </p>
    </aside>

    <!-- Content -->
    <main id="main" class="lg:w-[62%] lg:py-8">
      <Section id="work" title="Selected work">
        <div class="space-y-4">
          {featured.map((p) => <ProjectCard project={p} variant="featured" />)}
        </div>

        <h3 class="mt-12 mb-4 text-sm font-semibold text-fg-muted">Machine learning</h3>
        <div class="grid gap-3 sm:grid-cols-2">
          {ml.map((p) => <ProjectCard project={p} />)}
        </div>

        <h3 class="mt-10 mb-4 text-sm font-semibold text-fg-muted">Software engineering</h3>
        <div class="grid gap-3 sm:grid-cols-2">
          {swe.map((p) => <ProjectCard project={p} />)}
        </div>
      </Section>

      <Section id="experience" title="Experience">
        <ol class="space-y-8">
          {
            experience.map((e) => (
              <li class="grid gap-3 sm:grid-cols-[7.5rem_1fr] sm:gap-6">
                <div class="text-xs font-medium tracking-wide text-fg-faint uppercase sm:pt-1">
                  {e.dates}
                </div>
                <div>
                  <div class="flex items-start gap-3">
                    <Image
                      src={e.logo}
                      alt=""
                      width={64}
                      height={64}
                      class="mt-0.5 h-8 w-8 shrink-0 rounded-md bg-white object-contain p-0.5 ring-1 ring-line"
                    />
                    <div>
                      <h3 class="font-semibold leading-snug">
                        {e.role}
                      </h3>
                      <p class="text-sm text-fg-muted">
                        {e.url ? (
                          <a href={e.url} class="hover:text-accent" target="_blank" rel="noopener">
                            {e.company}
                          </a>
                        ) : (
                          e.company
                        )}
                      </p>
                    </div>
                  </div>
                  <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-fg-muted">
                    {e.bullets.map((b) => (
                      <li class="flex gap-2">
                        <span class="mt-[0.6em] h-1 w-1 shrink-0 rounded-full bg-fg-faint" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                  <TechChips items={e.tech} class="mt-3" />
                </div>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="research" title="Research & write-ups" subtitle="Technical reports from coursework and independent research.">
        <ol class="space-y-5">
          {
            papers.map((p) => (
              <li class="rounded-xl border border-line bg-bg-elev p-4">
                <h3 class="font-semibold leading-snug">
                  <a href={p.pdf} class="hover:text-accent" target="_blank" rel="noopener">
                    {p.title}
                  </a>
                </h3>
                <p class="mt-0.5 text-xs text-fg-faint">{p.venue}</p>
                <p class="mt-2 text-sm leading-relaxed text-fg-muted">{p.summary}</p>
                <div class="mt-2 flex flex-wrap gap-x-4 text-sm font-medium text-fg-muted">
                  <a href={p.pdf} class="inline-flex items-center gap-1 hover:text-accent" target="_blank" rel="noopener">
                    <Icon name="file" class="h-3.5 w-3.5" /> PDF
                  </a>
                  {p.code && (
                    <a href={p.code} class="inline-flex items-center gap-1 hover:text-accent" target="_blank" rel="noopener">
                      <Icon name="github" class="h-3.5 w-3.5" /> Code
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="education" title="Education">
        <ol class="space-y-8">
          {
            education.map((e) => (
              <li class="grid gap-3 sm:grid-cols-[7.5rem_1fr] sm:gap-6">
                <div class="text-xs font-medium tracking-wide text-fg-faint uppercase sm:pt-1">
                  {e.dates}
                </div>
                <div>
                  <div class="flex items-start gap-3">
                    <Image
                      src={e.logo}
                      alt=""
                      width={64}
                      height={64}
                      class="mt-0.5 h-8 w-8 shrink-0 rounded-md bg-white object-contain p-0.5 ring-1 ring-line"
                    />
                    <div>
                      <h3 class="font-semibold leading-snug">{e.degree}</h3>
                      <p class="text-sm text-fg-muted">
                        <a href={e.url} class="hover:text-accent" target="_blank" rel="noopener">
                          {e.school}
                        </a>
                      </p>
                    </div>
                  </div>
                  <p class="mt-2 text-sm text-fg-muted">{e.detail}</p>
                  {e.notes.length > 0 && (
                    <p class="mt-1 text-sm text-fg-muted">{e.notes.join(' · ')}</p>
                  )}
                  <details class="group mt-3">
                    <summary class="cursor-pointer list-none text-sm font-medium text-fg-muted hover:text-accent">
                      <span class="group-open:hidden">Show coursework</span>
                      <span class="hidden group-open:inline">Hide coursework</span>
                    </summary>
                    <div class="mt-3 grid gap-4 sm:grid-cols-2">
                      {e.courses.map((c) => (
                        <div>
                          <p class="mb-1 text-xs font-semibold text-fg-faint uppercase">{c.group}</p>
                          <ul class="space-y-0.5 text-sm text-fg-muted">
                            {c.items.map((i) => <li>{i}</li>)}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </details>
                </div>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="awards" title="Awards">
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            awards.map((a) => (
              <li class="rounded-xl border border-line bg-bg-elev p-4">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-semibold leading-snug">{a.title}</h3>
                  <span class="shrink-0 text-xs text-fg-faint">{a.year}</span>
                </div>
                <p class="text-xs text-fg-faint">{a.org}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-fg-muted">{a.note}</p>
              </li>
            ))
          }
        </ul>
      </Section>

      <footer class="border-t border-line py-10 text-sm text-fg-muted">
        <p>
          Want to talk? Email <a href={`mailto:${profile.email}`} class="font-medium text-fg hover:text-accent">{profile.email}</a>.
        </p>
        <p class="mt-2 text-xs text-fg-faint">
          Built with Astro and Tailwind. <a href={profile.github + '/Alex-Kozik-Portfolio'} class="hover:text-fg">Source on GitHub</a>.
        </p>
      </footer>
    </main>
  </div>

  <script>
    // Highlight the sidebar link for the section currently in view.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav]'));
    const sections = links
      .map((l) => document.getElementById(l.dataset.nav!))
      .filter((s): s is HTMLElement => !!s);
    const setCurrent = (id: string) =>
      links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.nav === id)));
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setCurrent(visible.target.id);
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: [0, 0.25, 0.5] }
    );
    sections.forEach((s) => observer.observe(s));
  </script>
</BaseLayout>
