---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import { profile } from '../data/profile';
import portrait from '../assets/alex.jpeg';

const contact = [
  { href: profile.resume, label: 'résumé', event: 'resume' },
  { href: profile.linkedin, label: 'linkedin', event: 'linkedin' },
  { href: `mailto:${profile.email}`, label: 'email', event: 'email' },
  { href: profile.github, label: 'github', event: 'github' },
];
const ext = (href: string) => (href.startsWith('http') || href.endsWith('.pdf') ? { target: '_blank', rel: 'noopener' } : {});
---

<Page current="/">
  <section aria-label="About" class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between sm:gap-12 sm:pt-6">
    <div class="min-w-0 flex-1">
      <h1 class="t-page group">Alex Kozik <span class="spark" aria-hidden="true">✻</span></h1>
      <div class="t-sub mt-4 space-y-3">
        <p>I study computer science at Carnegie Mellon.</p>
        <p>I'm interested in reinforcement learning for foundation models and machine learning systems.</p>
        <p>Before CMU, I studied at Cornell and interned at Amazon and Salesforce.</p>
        <p>I enjoy teaching, working out, and reading.</p>
      </div>
      <p class="t-sub mt-5 flex flex-wrap gap-x-4 gap-y-1">
        {
          contact.map((c) => (
            <a href={c.href} class="ink" data-umami-event={c.event} {...ext(c.href)}>
              {c.label}
            </a>
          ))
        }
      </p>
    </div>
    <figure class="relative shrink-0 self-start">
      <Image
        src={portrait}
        alt="Alex Kozik"
        width={400}
        height={400}
        class="h-32 w-32 rounded-full object-cover sm:h-44 sm:w-44"
        loading="eager"
      />
      <button
        type="button"
        class="peer absolute right-1 bottom-1 inline-flex h-6 w-6 items-center justify-center rounded-full border border-line bg-bg font-display text-[13px] text-fg-muted italic transition hover:text-fg sm:right-2 sm:bottom-2"
        aria-label="About this photo"
        aria-describedby="photo-note"
      >i</button>
      <figcaption
        id="photo-note"
        role="tooltip"
        class="t-meta pointer-events-none absolute top-full left-0 z-10 sm:right-0 sm:left-auto mt-2 w-60 rounded-lg border border-line bg-bg-elev p-2.5 opacity-0 shadow-sm transition-opacity peer-hover:opacity-100 peer-focus:opacity-100"
      >
        Standing to be recognized for the Jonathan E. Marx Memorial Senior Prize at Cornell’s 2026 CS graduation.
      </figcaption>
    </figure>
  </section>

</Page>
