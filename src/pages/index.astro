---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import Timeline from '../components/Timeline.astro';
import { profile, nav } from '../data/profile';
import { experience } from '../data/experience';
import { education } from '../data/education';
import { awards } from '../data/awards';
import { papers } from '../data/papers';
import { demos } from '../data/demos';
import portrait from '../assets/alex.jpeg';

const all = await getCollection('projects');
const featured = all.filter((p) => p.data.group === 'featured').sort((a, b) => a.data.order - b.data.order);

// Small tiles on the homepage; everything else lives on /projects.
const MORE = ['c-torch', 'dx', 'mnist-classifier', 'snake-dqn', 'text2code', 'english2logic', 'sasylf', 'obsidiandb'];
const more = (await Promise.all(MORE.map((id) => getEntry('projects', id)))).filter((p) => p !== undefined);

const socials = [
  { href: profile.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: `mailto:${profile.email}`, label: 'Email', icon: 'mail' },
  { href: profile.github, label: 'GitHub', icon: 'github' },
] as const;
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---

<BaseLayout>
  <!-- Frosted global nav -->
  <header class="sticky top-0 z-40 border-b border-line/60 bg-bg/75 backdrop-blur-xl backdrop-saturate-150">
    <div class="mx-auto flex h-12 max-w-5xl items-center gap-6 px-5">
      <a href="#about" class="shrink-0 text-[15px] font-semibold tracking-[-0.01em]">Alex Kozik</a>
      <nav class="flex min-w-0 flex-1 gap-x-6 overflow-x-auto text-[13px] text-fg-muted [scrollbar-width:none] md:justify-center" aria-label="Sections">
        {
          nav.map((n) => (
            <a href={`#${n.id}`} data-nav={n.id} class="shrink-0 transition hover:text-fg aria-[current=true]:text-fg">
              {n.label}
            </a>
          ))
        }
      </nav>
      <div class="hidden items-center gap-4 text-fg-muted sm:flex">
        {
          socials.map((s) => (
            <a href={s.href} aria-label={s.label} title={s.label} class="transition hover:text-fg" data-umami-event={s.label.toLowerCase()} {...ext(s.href)}>
              <Icon name={s.icon} class="h-4 w-4" />
            </a>
          ))
        }
      </div>
      <ThemeToggle />
    </div>
  </header>

  <main id="main" class="mx-auto max-w-5xl px-5 pb-32">
    <!-- About: centered hero -->
    <section id="about" class="scroll-mt-14 pt-20 text-center sm:pt-28">
      <Image src={portrait} alt="Alex Kozik" width={320} height={320} class="mx-auto h-28 w-28 rounded-full object-cover sm:h-36 sm:w-36" loading="eager" />
      <h1 class="mt-8 text-6xl font-semibold tracking-[-0.04em] sm:text-8xl">Alex Kozik</h1>
      <p class="mx-auto mt-4 w-fit bg-gradient-to-r from-[#0071e3] via-[#7d5cf0] to-[#e5487f] bg-clip-text text-2xl font-semibold tracking-[-0.02em] text-transparent sm:text-3xl dark:from-[#2997ff] dark:via-[#a78bfa] dark:to-[#ff6b9a]">
        ML Research Engineer.
      </p>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted sm:text-xl">
        {profile.bio[0]} Before CMU, I studied computer science and mathematics at Cornell and interned at Amazon and Salesforce.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-[17px]">
        <a
          href={profile.resume}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-accent px-6 py-2.5 font-medium text-white transition hover:opacity-90"
          data-umami-event="resume"
        >
          Résumé
        </a>
        {
          socials.map((s) => (
            <a href={s.href} class="more" data-umami-event={s.label.toLowerCase()} {...ext(s.href)}>
              {s.label} ›
            </a>
          ))
        }
      </div>
    </section>

    <Section id="education" title="Education.">
      <div class="grid gap-3 md:grid-cols-2">
        {
          education.map((e) => (
            <article class="frame p-7" data-reveal>
              <Image src={e.logo} alt="" width={112} height={112} class="h-12 w-12 rounded-xl bg-white object-contain p-1.5 shadow-[0_0_0_1px_rgba(0,0,0,0.06)]" />
              <p class="label mt-5">{e.dates}</p>
              <h3 class="mt-1 text-xl font-semibold tracking-[-0.02em]">{e.degree}</h3>
              <p class="text-fg-muted">
                <a href={e.url} class="hover:text-accent" target="_blank" rel="noopener">{e.school}</a>
              </p>
              <p class="mt-3 text-[15px] leading-relaxed text-fg-muted">{e.detail}</p>
              {e.notes.length > 0 && <p class="text-[15px] leading-relaxed text-fg-muted">{e.notes.join(' · ')}</p>}
              <details class="group mt-3">
                <summary class="more cursor-pointer list-none text-[15px]">
                  <span class="group-open:hidden">Coursework ›</span>
                  <span class="hidden group-open:inline">Hide coursework</span>
                </summary>
                <div class="mt-3 grid gap-4 sm:grid-cols-2">
                  {e.courses.map((c) => (
                    <div>
                      <p class="label mb-1 font-medium">{c.group}</p>
                      <ul class="space-y-0.5 text-sm text-fg-muted">
                        {c.items.map((i) => <li>{i}</li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="experience" title="Experience.">
      <Timeline items={experience.filter((e) => !e.research)} />
    </Section>

    <Section id="research" title="Research.">
      <Timeline items={experience.filter((e) => e.research)} />
    </Section>

    <Section id="awards" title="Awards and honors.">
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          awards.map((a) => (
            <li class="frame p-6" data-reveal>
              <p class="label">
                {a.year} · {a.org}
              </p>
              <h3 class="mt-1 text-lg font-semibold leading-snug tracking-[-0.01em]">{a.title}</h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-fg-muted">{a.note}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="papers" title="Papers.">
      <ol class="frame divide-y divide-line/70 px-7" data-reveal>
        {
          papers.map((p) => (
            <li class="py-6">
              <p class="label">{p.venue}</p>
              <h3 class="mt-1 text-lg font-semibold leading-snug tracking-[-0.01em]">{p.title}</h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-fg-muted">{p.summary}</p>
              <p class="mt-2 flex flex-wrap gap-x-5 text-[15px]">
                <a href={p.pdf} class="more" target="_blank" rel="noopener" data-umami-event="report" data-umami-event-project={p.title}>
                  Read the paper ›
                </a>
                {p.project && (
                  <a href={p.project} class="more">
                    Project ›
                  </a>
                )}
                {p.code && (
                  <a href={p.code} class="more" target="_blank" rel="noopener">
                    Code ›
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="projects" title="Projects." subtitle="Four I'd show first. Two of them run right here in your browser.">
      <div class="grid gap-3 md:grid-cols-2">
        {featured.map((p, i) => <Entry project={p} n={i + 1} />)}
      </div>

      <h3 class="mt-16 mb-5 text-2xl font-semibold tracking-[-0.02em]">More projects.</h3>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          more.map((p) => (
            <li class="frame flex flex-col p-6" data-reveal>
              <p class="label">
                {p.data.date}
                {(demos[p.id] || p.data.demo) && <span class="text-accent"> · Live</span>}
              </p>
              <h4 class="mt-1 text-lg font-semibold tracking-[-0.01em]">{p.data.title}</h4>
              <p class="mt-1.5 flex-1 text-[15px] leading-snug text-fg-muted">{(p.data.question ?? p.data.description).replace(/\.$/, '')}</p>
              <a href={`/projects/${p.id}/`} class="more mt-4 text-[15px]">
                Learn more ›
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-center text-[17px]">
        <a href="/projects/" class="more">See all {all.length} projects ›</a>
      </p>
    </Section>
  </main>

  <script>
    // Highlight the nav link for the section in view, and ease tiles in as they appear.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav]'));
    const sections = links.map((l) => document.getElementById(l.dataset.nav!)).filter((s): s is HTMLElement => !!s);
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.nav === visible.target.id)));
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: [0, 0.25, 0.5] },
    );
    sections.forEach((s) => spy.observe(s));

    const reveal = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            reveal.unobserve(e.target);
          }
        }),
      { rootMargin: '0px 0px -8% 0px' },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));
  </script>
</BaseLayout>
