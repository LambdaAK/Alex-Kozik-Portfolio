---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Timeline from '../components/Timeline.astro';
import { profile, nav } from '../data/profile';
import { experience } from '../data/experience';
import { education } from '../data/education';
import { awards } from '../data/awards';
import { papers } from '../data/papers';
import portrait from '../assets/alex.jpeg';

const all = await getCollection('projects');
const byGroup = (g: 'featured' | 'ml' | 'systems' | 'archive') =>
  all.filter((p) => p.data.group === g).sort((a, b) => a.data.order - b.data.order);
const featured = byGroup('featured');
const ml = byGroup('ml');
const systems = byGroup('systems');
const archiveCount = byGroup('archive').length;

const socials = [
  { href: profile.github, label: 'GitHub', icon: 'github' },
  { href: profile.linkedin, label: 'LinkedIn', icon: 'linkedin' },
] as const;
---

<BaseLayout>
  <!-- Mobile top bar: section anchors and résumé, always reachable. -->
  <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur lg:hidden">
    <nav class="mx-auto flex max-w-6xl items-center gap-4 overflow-x-auto px-6 py-3 text-sm font-medium" aria-label="Sections">
      {nav.map((n) => <a href={`#${n.id}`} class="shrink-0 text-fg-muted hover:text-fg">{n.label}</a>)}
      <a
        href={profile.resume}
        class="ml-auto shrink-0 rounded-full bg-fg px-3 py-1 text-xs font-semibold text-bg"
        target="_blank"
        rel="noopener"
        data-umami-event="resume"
      >
        Résumé
      </a>
    </nav>
  </header>

  <div class="mx-auto max-w-6xl px-6 lg:flex lg:gap-12 lg:px-12 xl:gap-20">
    <!-- Sidebar / hero -->
    <aside class="flex flex-col pt-10 lg:sticky lg:top-0 lg:h-screen lg:w-[38%] lg:shrink-0 lg:overflow-y-auto lg:py-16">
      <div class="flex items-start justify-between gap-4">
        <Image
          src={portrait}
          alt="Alex Kozik"
          width={224}
          height={224}
          class="h-20 w-20 rounded-full object-cover ring-2 ring-line lg:h-24 lg:w-24"
          loading="eager"
        />
        <ThemeToggle />
      </div>

      <h1 class="mt-6 font-display text-4xl font-semibold tracking-tight lg:text-5xl">{profile.name}</h1>

      <div class="mt-5 space-y-3 text-sm leading-relaxed text-fg-muted">
        {profile.bio.map((p) => <p>{p}</p>)}
      </div>


      <div class="mt-6 flex flex-wrap gap-2">
        <a
          href={profile.resume}
          class="inline-flex items-center gap-2 rounded-full bg-fg px-4 py-2 text-sm font-semibold text-bg transition hover:opacity-85"
          target="_blank"
          rel="noopener"
          data-umami-event="resume"
        >
          <Icon name="file" /> Résumé
        </a>
        <CopyEmail email={profile.email} />
        {
          socials.map((s) => (
            <a
              href={s.href}
              class="inline-flex items-center rounded-full border border-line px-3 py-2 text-fg-muted transition hover:border-accent hover:text-fg"
              target="_blank"
              rel="noopener"
              aria-label={s.label}
              title={s.label}
              data-umami-event={s.label.toLowerCase()}
            >
              <Icon name={s.icon} />
            </a>
          ))
        }
      </div>

      <nav class="mt-10 hidden lg:block" aria-label="Sections">
        <ul class="space-y-3">
          {
            nav.map((n) => (
              <li>
                <a
                  href={`#${n.id}`}
                  data-nav={n.id}
                  class="group flex items-center gap-3 text-xs font-semibold tracking-[0.18em] text-fg-faint uppercase transition hover:text-fg aria-[current=true]:text-fg"
                >
                  <span class="h-px w-6 bg-fg-faint transition-all group-hover:w-12 group-hover:bg-fg group-aria-[current=true]:w-12 group-aria-[current=true]:bg-fg" />
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

    </aside>

    <!-- Content -->
    <main id="main" class="pb-16 lg:w-[62%] lg:py-8">

      <Section id="research" title="Research">
        <Timeline items={experience.filter((e) => e.research)} />

        <h3 class="mt-12 mb-1 text-sm font-semibold text-fg-muted">Papers</h3>
        <ol class="divide-y divide-line">
          {
            papers.map((p) => (
              <li class="py-4">
                <h4 class="font-semibold leading-snug">
                  <a href={p.project ?? p.pdf} class="hover:text-accent" {...(p.project ? {} : { target: '_blank', rel: 'noopener' })}>
                    {p.title}
                  </a>
                </h4>
                <p class="mt-0.5 text-xs text-fg-faint">{p.venue}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-fg-muted">{p.summary}</p>
                <div class="mt-1.5 flex flex-wrap gap-x-4 text-sm font-medium text-fg-muted">
                  <a href={p.pdf} class="inline-flex items-center gap-1 hover:text-accent" target="_blank" rel="noopener" data-umami-event="report" data-umami-event-project={p.title}>
                    <Icon name="file" class="h-3.5 w-3.5" /> PDF
                  </a>
                  {p.code && (
                    <a href={p.code} class="inline-flex items-center gap-1 hover:text-accent" target="_blank" rel="noopener" data-umami-event="source" data-umami-event-project={p.title}>
                      <Icon name="github" class="h-3.5 w-3.5" /> Code
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="work" title="Selected work">
        <div class="space-y-4">
          {featured.map((p) => <ProjectCard project={p} variant="featured" />)}
        </div>

        <div class="mt-12 grid gap-x-10 sm:grid-cols-2">
          <div>
            <h3 class="text-sm font-semibold text-fg-muted">More machine learning</h3>
            <div class="divide-y divide-line">
              {ml.map((p) => <ProjectCard project={p} />)}
            </div>
          </div>
          <div class="mt-8 sm:mt-0">
            <h3 class="text-sm font-semibold text-fg-muted">Systems</h3>
            <div class="divide-y divide-line">
              {systems.map((p) => <ProjectCard project={p} />)}
            </div>
          </div>
        </div>

        <p class="mt-6">
          <a href="/projects/" class="inline-flex items-center gap-1 text-sm font-medium text-fg-muted hover:text-accent">
            All projects, including {archiveCount} more <Icon name="arrow" class="h-3.5 w-3.5" />
          </a>
        </p>
      </Section>

      <Section id="experience" title="Experience">
        <Timeline items={experience.filter((e) => !e.research)} />
      </Section>

      <Section id="about" title="About">
        <h3 class="mb-4 text-sm font-semibold text-fg-muted">Education</h3>
        <ol class="space-y-8">
          {
            education.map((e) => (
              <li class="grid gap-3 sm:grid-cols-[7.5rem_1fr] sm:gap-6">
                <div class="text-xs font-medium tracking-wide text-fg-faint uppercase sm:pt-1">
                  {e.dates}
                </div>
                <div>
                  <div class="flex items-center gap-4">
                    <Image
                      src={e.logo}
                      alt=""
                      width={112}
                      height={112}
                      class="h-12 w-12 shrink-0 rounded-lg bg-white object-contain p-1 ring-1 ring-line sm:h-14 sm:w-14"
                    />
                    <div>
                      <h4 class="font-semibold leading-snug">{e.degree}</h4>
                      <p class="text-sm text-fg-muted">
                        <a href={e.url} class="hover:text-accent" target="_blank" rel="noopener">
                          {e.school}
                        </a>
                      </p>
                    </div>
                  </div>
                  <p class="mt-2 text-sm text-fg-muted">{e.detail}</p>
                  {e.notes.length > 0 && (
                    <p class="mt-1 text-sm text-fg-muted">{e.notes.join(' · ')}</p>
                  )}
                  <details class="group mt-3">
                    <summary class="cursor-pointer list-none text-sm font-medium text-fg-muted hover:text-accent">
                      <span class="group-open:hidden">Show coursework</span>
                      <span class="hidden group-open:inline">Hide coursework</span>
                    </summary>
                    <div class="mt-3 grid gap-4 sm:grid-cols-2">
                      {e.courses.map((c) => (
                        <div>
                          <p class="mb-1 text-xs font-semibold text-fg-faint uppercase">{c.group}</p>
                          <ul class="space-y-0.5 text-sm text-fg-muted">
                            {c.items.map((i) => <li>{i}</li>)}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </details>
                </div>
              </li>
            ))
          }
        </ol>

        <h3 class="mt-12 mb-2 text-sm font-semibold text-fg-muted">Awards</h3>
        <ul class="divide-y divide-line">
          {
            awards.map((a) => (
              <li class="grid gap-1 py-3 sm:grid-cols-[1fr_auto] sm:gap-4">
                <div>
                  <p class="font-medium leading-snug">{a.title}</p>
                  <p class="text-xs text-fg-faint">{a.org}</p>
                  <p class="mt-0.5 text-sm text-fg-muted">{a.note}</p>
                </div>
                <span class="text-xs text-fg-faint sm:pt-1">{a.year}</span>
              </li>
            ))
          }
        </ul>
      </Section>

    </main>
  </div>

  <script>
    // Highlight the sidebar link for the section currently in view.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav]'));
    const sections = links
      .map((l) => document.getElementById(l.dataset.nav!))
      .filter((s): s is HTMLElement => !!s);
    const setCurrent = (id: string) =>
      links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.nav === id)));
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setCurrent(visible.target.id);
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: [0, 0.25, 0.5] }
    );
    sections.forEach((s) => observer.observe(s));
  </script>
</BaseLayout>
