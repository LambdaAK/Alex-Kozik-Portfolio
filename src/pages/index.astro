---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import Timeline from '../components/Timeline.astro';
import { profile, nav } from '../data/profile';
import { experience } from '../data/experience';
import { education } from '../data/education';
import { awards } from '../data/awards';
import { papers } from '../data/papers';
import { demos } from '../data/demos';
import portrait from '../assets/alex.jpeg';

const all = await getCollection('projects');
const featured = all.filter((p) => p.data.group === 'featured').sort((a, b) => a.data.order - b.data.order);

// One line each on the homepage; everything else lives on /projects.
const MORE = ['c-torch', 'dx', 'mnist-classifier', 'snake-dqn', 'text2code', 'english2logic', 'sasylf', 'obsidiandb'];
const more = (await Promise.all(MORE.map((id) => getEntry('projects', id)))).filter((p) => p !== undefined);

const contact = [
  { href: `mailto:${profile.email}`, label: 'email', event: 'email' },
  { href: profile.github, label: 'github', event: 'github' },
  { href: profile.linkedin, label: 'linkedin', event: 'linkedin' },
  { href: profile.resume, label: 'résumé', event: 'resume' },
];
const external = (href: string) => (href.startsWith('http') || href.endsWith('.pdf') ? { target: '_blank', rel: 'noopener' } : {});
---

<BaseLayout>
  <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
    <div class="mx-auto flex max-w-[56rem] items-center gap-x-6 gap-y-1 px-6 py-3">
      <a href="/" class="label shrink-0 text-fg hover:text-accent">Alex Kozik</a>
      <nav class="label flex min-w-0 flex-1 gap-x-5 overflow-x-auto [scrollbar-width:none]" aria-label="Sections">
        {
          nav.map((n) => (
            <a href={`#${n.id}`} data-nav={n.id} class="shrink-0 transition hover:text-fg aria-[current=true]:text-accent">
              {n.label.toLowerCase()}
            </a>
          ))
        }
        <a href={profile.resume} class="shrink-0 hover:text-fg" target="_blank" rel="noopener" data-umami-event="resume">résumé</a>
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <main id="main" class="mx-auto max-w-[56rem] px-6 pb-24">
    <!-- Opening -->
    <section class="grid gap-x-10 pt-16 lg:grid-cols-[minmax(0,42rem)_11rem] lg:pt-24">
      <div>
        <h1 class="text-[2.6rem] leading-[1.1] font-semibold tracking-tight sm:text-5xl">{profile.name}</h1>
        <p class="mt-6 text-[1.45rem] leading-snug text-fg sm:text-[1.6rem]">{profile.bio[0]}</p>
        <p class="mt-4 text-fg-muted">
          On the side I build languages and learning systems: <a href="/projects/forge/#demo" class="ink">Forge</a>, a typed
          functional language you can run on this page; <a href="/projects/anvil-lang/" class="ink">Anvil</a>, a tensor compiler
          that fuses whole training loops; and a <a href="/projects/poker-games/#demo" class="ink">poker bot</a> you can try to beat.
        </p>
        <p class="label mt-6 flex flex-wrap gap-x-5 gap-y-1">
          {
            contact.map((c) => (
              <a href={c.href} class="text-fg-muted hover:text-accent" data-umami-event={c.event} {...external(c.href)}>
                {c.label}
              </a>
            ))
          }
        </p>
      </div>
      <aside class="hidden lg:mt-2 lg:block">
        <Image src={portrait} alt="Alex Kozik" width={176} height={176} class="h-24 w-24 object-cover grayscale-[15%] sepia-[12%] lg:h-28 lg:w-28" loading="eager" />
      </aside>
    </section>

    <Section id="experience" title="Experience" mark="§1">
      <Timeline items={experience.filter((e) => !e.research)} />
    </Section>

    <Section id="research" title="Research" mark="§2">
      <Timeline items={experience.filter((e) => e.research)} />

      <h3 class="label mt-10 mb-3 uppercase tracking-[0.12em]">Papers</h3>
      <ol class="space-y-3">
        {
          papers.map((p) => (
            <li class="grid gap-x-10 lg:grid-cols-[minmax(0,42rem)_11rem]">
              <p>
                <a href={p.project ?? p.pdf} class="ink" {...(p.project ? {} : { target: '_blank', rel: 'noopener' })}>
                  {p.title}
                </a>
                <span class="text-fg-muted"> — {p.venue}</span>
              </p>
              <p class="label lg:pt-1.5">
                <a href={p.pdf} class="hover:text-accent" target="_blank" rel="noopener" data-umami-event="report" data-umami-event-project={p.title}>
                  PDF ↗
                </a>
              </p>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="work" title="Selected work" mark="§3">
      <div class="space-y-16">
        {featured.map((p, i) => <Entry project={p} n={i + 1} />)}
      </div>

      <h3 class="label mt-20 mb-3 uppercase tracking-[0.12em]">More work</h3>
      <ul class="divide-y divide-line border-y border-line">
        {
          more.map((p) => (
            <li class="grid gap-x-10 py-2.5 lg:grid-cols-[minmax(0,42rem)_11rem]">
              <p class="min-w-0">
                <a href={`/projects/${p.id}/`} class="ink">
                  {p.data.title}
                </a>
                <span class="text-fg-muted"> — {(p.data.question ?? p.data.description).replace(/\.$/, '')}</span>
              </p>
              <p class="label lg:pt-1.5">
                {p.data.date}
                {(demos[p.id] || p.data.demo) && <span class="text-accent"> · live</span>}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="label mt-4">
        <a href="/projects/" class="text-accent hover:underline">All {all.length} projects →</a>
      </p>
    </Section>

    <Section id="about" title="About" mark="§4">
      <ol class="divide-y divide-line border-y border-line">
        {
          education.map((e) => (
            <li class="grid gap-x-10 py-3 lg:grid-cols-[minmax(0,42rem)_11rem]">
              <div>
                <p>
                  {e.degree}
                  <span class="text-fg-muted"> — {e.school}</span>
                </p>
                <p class="mt-0.5 text-[16px] text-fg-muted">{e.detail}</p>
              </div>
              <p class="label lg:pt-1.5">{e.dates}</p>
            </li>
          ))
        }
      </ol>

      <h3 class="label mt-10 mb-3 uppercase tracking-[0.12em]">Awards</h3>
      <ul class="space-y-2">
        {
          awards.map((a) => (
            <li class="grid gap-x-10 lg:grid-cols-[minmax(0,42rem)_11rem]">
              <p>
                {a.title}
                <span class="text-fg-muted"> — {a.note}</span>
              </p>
              <p class="label lg:pt-1.5">{a.year}</p>
            </li>
          ))
        }
      </ul>
    </Section>
  </main>

  <script>
    // Mark the nav link for the section currently in view.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav]'));
    const sections = links.map((l) => document.getElementById(l.dataset.nav!)).filter((s): s is HTMLElement => !!s);
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.nav === visible.target.id)));
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: [0, 0.25, 0.5] },
    );
    sections.forEach((s) => observer.observe(s));
  </script>
</BaseLayout>
