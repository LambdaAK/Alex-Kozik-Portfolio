---
import Page from '../layouts/Page.astro';
import { profile } from '../data/profile';
import { awards } from '../data/awards';
---

<Page current="/awards/" heading="Awards" title={`Awards – ${profile.name}`} path="/awards/">
    <ul class="space-y-3">
      {
        awards.map((a) => (
          <li class="flex items-baseline justify-between gap-4">
            <p>
              {a.title}
              <span class="text-fg-muted"> · {a.org}</span>
            </p>
            <span class="shrink-0 text-sm text-fg-faint">{a.year}</span>
          </li>
        ))
      }
    </ul>
</Page>
