---
import ProjectMedia from '../../components/ProjectMedia.astro';
import ProjectIcon from '../../components/ProjectIcon.astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TechChips from '../../components/TechChips.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import Results from '../../components/Results.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import SnakeDemo from '../../components/SnakeDemo.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { title, tagline, question, description, date, role, tech, github, demo, website, paper, links, image, media, mediaAlt, video, results, highlights } =
  project.data;
const { Content } = await render(project);
const hasBody = (project.body ?? '').trim().length > 0;
---

<BaseLayout
  title={`${title} – ${profile.name}`}
  description={tagline}
  path={`/projects/${project.id}/`}
  ogImage={`/og/${project.id}.png`}
>
  <div class="mx-auto max-w-3xl px-6 py-10 lg:py-16">
    <header class="flex items-center justify-between">
      <a href="/#work" class="inline-flex items-center gap-1 text-sm font-medium text-fg-muted hover:text-accent">
        ← {profile.name}
      </a>
      <ThemeToggle />
    </header>

    <main id="main" class="mt-10">
      <div class="flex items-start gap-5">
        <ProjectIcon image={image} title={title} size={64} class="h-14 w-14 shrink-0 rounded-xl text-xl sm:h-16 sm:w-16" />
        <div class="min-w-0">
          <h1 class="font-display text-4xl font-semibold tracking-tight">{title}</h1>
          {question && <p class="mt-1 font-display text-lg italic leading-snug text-fg-muted">{question}</p>}
        </div>
      </div>

      <p class="mt-6 text-base font-medium leading-relaxed text-fg">{tagline}</p>
      <p class="mt-2 text-sm text-fg-faint">
        {date}{role && <> · {role}</>}
      </p>

      <Results results={results} class="mt-6" />

      <TechChips items={tech} class="mt-6" />
      <ProjectLinks github={github} demo={demo} website={website} paper={paper} links={links} project={title} class="mt-4" />

      {
        media && (
          <figure class="mt-8">
            <ProjectMedia media={media} video={video} alt={mediaAlt} width={1200} class="w-full rounded-xl bg-white ring-1 ring-line" />
            {mediaAlt && <figcaption class="mt-2 text-xs text-fg-faint">{mediaAlt}</figcaption>}
          </figure>
        )
      }

      {project.id === 'snake-dqn' && <SnakeDemo />}

      <p class="mt-8 text-[15px] leading-relaxed text-fg-muted">{description}</p>

      {
        highlights.length > 0 && (
          <section class="mt-8" aria-labelledby="highlights">
            <h2 id="highlights" class="text-xs font-semibold tracking-[0.18em] text-fg-faint uppercase">
              Highlights
            </h2>
            <ul class="mt-3 space-y-2 text-[15px] leading-relaxed text-fg-muted">
              {highlights.map((h) => (
                <li class="flex gap-2">
                  <span class="mt-[0.65em] h-1 w-1 shrink-0 rounded-full bg-fg-faint" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        hasBody && (
          <article class="prose mt-10 border-t border-line pt-8 text-[15px] text-fg">
            <Content />
          </article>
        )
      }

      <p class="mt-12 flex justify-between border-t border-line pt-6 text-sm text-fg-muted">
        <a href="/#work" class="inline-flex items-center gap-1 hover:text-accent">
          <Icon name="arrow" class="h-3.5 w-3.5 rotate-180" /> Home
        </a>
        <a href="/projects/" class="inline-flex items-center gap-1 hover:text-accent">
          All projects <Icon name="arrow" class="h-3.5 w-3.5" />
        </a>
      </p>
    </main>
  </div>
</BaseLayout>
