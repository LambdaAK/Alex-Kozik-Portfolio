---
import ProjectMedia from '../../components/ProjectMedia.astro';
import ProjectIcon from '../../components/ProjectIcon.astro';
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import SnakeDemo from '../../components/SnakeDemo.astro';
import ForgePlayground from '../../components/ForgePlayground.astro';
import { profile } from '../../data/profile';
import { demos } from '../../data/demos';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { title, tagline, question, description, date, role, tech, github, demo, website, paper, links, image, imageDark, media, mediaAlt, video, results, highlights } =
  project.data;
const { Content } = await render(project);
const hasBody = (project.body ?? '').trim().length > 0;
---

<Page current="/projects/" title={`${title} – ${profile.name}`} description={tagline} path={`/projects/${project.id}/`} ogImage={`/og/${project.id}.png`}>
  {project.id === 'forge' && <ProjectIcon image={image} dark={imageDark} title={title} size={48} class="mb-5 h-12 w-12" />}
  <h1 class="text-3xl font-semibold tracking-[-0.03em] sm:text-4xl">{title}</h1>
  {question && <p class="mt-3 text-lg leading-snug text-fg-muted">{question}</p>}
  <p class="mt-5">{tagline}</p>
  <p class="mt-3 text-sm text-fg-faint">{[date, role].filter(Boolean).join(' · ')}</p>

  {
    results.length > 0 && (
      <dl class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-3">
        {results.map((r) => (
          <div>
            <dd class="font-medium">{r.value}</dd>
            <dt class="text-sm text-fg-muted">{r.metric}</dt>
            {r.baseline && <dd class="text-sm text-fg-faint">{r.baseline}</dd>}
          </div>
        ))}
      </dl>
    )
  }

  <p class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-[15px]">
    {demos[project.id] && <a href="#demo" class="ink">{demos[project.id]} ↓</a>}
    {demo && <a href={demo} class="ink" target="_blank" rel="noopener">live demo</a>}
    {website && <a href={website} class="ink" target="_blank" rel="noopener">website</a>}
    {github && <a href={github} class="ink" target="_blank" rel="noopener" data-umami-event="source" data-umami-event-project={title}>source</a>}
    {paper && <a href={paper} class="ink" target="_blank" rel="noopener" data-umami-event="report" data-umami-event-project={title}>report (pdf)</a>}
    {links.filter((l) => !l.href.includes('#playground')).map((l) => (
      <a href={l.href} class="ink" {...(l.href.startsWith('/') && !l.href.endsWith('.pdf') ? {} : { target: '_blank', rel: 'noopener' })}>
        {l.label}
      </a>
    ))}
  </p>
  <p class="mt-2 text-sm text-fg-faint">{tech.join(' · ')}</p>

  {
    demos[project.id] && (
      <div id="demo" class="mt-10 scroll-mt-8">
        {project.id === 'snake-dqn' && <SnakeDemo />}
        {project.id === 'forge' && <ForgePlayground />}
      </div>
    )
  }

  {
    media && (
      <figure class="mt-10">
        <ProjectMedia media={media} video={video} alt={mediaAlt} width={1200} class="w-full rounded-xl bg-bg-elev p-2" />
        {mediaAlt && <figcaption class="mt-2 text-sm leading-relaxed text-fg-faint">{mediaAlt}</figcaption>}
      </figure>
    )
  }

  <p class="mt-10 leading-relaxed text-fg-muted">{description}</p>

  {
    highlights.length > 0 && (
      <ul class="mt-5 list-disc space-y-2 pl-5 leading-relaxed text-fg-muted marker:text-fg-faint">
        {highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }

  {
    hasBody && (
      <article class="prose mt-6 text-fg">
        <Content />
      </article>
    )
  }

  <p class="mt-16 border-t border-line pt-5 text-sm">
    <a href="/projects/" class="ink text-fg-muted">← all projects</a>
  </p>
</Page>
