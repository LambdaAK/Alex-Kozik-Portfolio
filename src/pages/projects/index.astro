---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { profile } from '../../data/profile';
import { demos } from '../../data/demos';

const all = await getCollection('projects');
const byOrder = (g: string) => all.filter((p) => p.data.group === g).sort((a, b) => a.data.order - b.data.order);
const featured = byOrder('featured');
const others = [
  { label: 'ML / AI', items: byOrder('ml') },
  { label: 'Software engineering', items: byOrder('systems') },
];
---

<Page
  current="/projects/"
  heading="Projects"
  title={`Projects – ${profile.name}`}
  description={`Projects by ${profile.name}: a compiler, an LLM serving stack, a C++ ML library, RL agents and more.`}
  path="/projects/"
>
  <ul class="space-y-6">
    {
      featured.map((p) => {
        const r = p.data.results[0];
        return (
          <li>
            <div class="flex items-baseline justify-between gap-4">
              <p>
                <a href={`/projects/${p.id}/`} class="ink font-medium" data-umami-event="project-open" data-umami-event-project={p.data.title}>
                  {p.data.title}
                </a>
                {demos[p.id] && (
                  <a href={`/projects/${p.id}/#demo`} class="ml-2 text-sm text-fg-faint hover:text-fg">
                    {demos[p.id]} →
                  </a>
                )}
              </p>
              <span class="shrink-0 text-sm text-fg-faint">{p.data.date}</span>
            </div>
            <p class="mt-1 leading-relaxed text-fg-muted">{p.data.question ?? p.data.description}</p>
            {r && (
              <p class="mt-0.5 text-sm text-fg-faint">
                {r.value} · {r.metric}
              </p>
            )}
          </li>
        );
      })
    }
  </ul>

  {
    others.map((g) => (
      <section class="mt-10" aria-label={g.label}>
        <h2 class="text-[15px] font-medium text-fg-faint">{g.label}</h2>
        <ul class="mt-3 space-y-2.5">
          {g.items.map((p) => (
            <li class="flex items-baseline justify-between gap-4">
              <p class="min-w-0">
                <a href={`/projects/${p.id}/`} class="ink">
                  {p.data.title}
                </a>
                {(demos[p.id] || p.data.demo) && <span class="text-sm text-fg-faint"> · live</span>}
              </p>
              <span class="shrink-0 text-sm text-fg-faint">{p.data.date}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Page>
