---
// Live demo: draw a digit, the trained CNN classifies it in the browser. Weights (1.6 MB) load on first stroke.
---

<section class="mnist-demo mt-8 rounded-xl border border-line bg-bg-elev p-4 sm:p-5" aria-labelledby="mnist-demo-title">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="mnist-demo-title" class="font-display text-xl font-semibold">Draw a digit</h2>
    <p class="text-xs text-fg-faint">The trained CNN, running in your browser. No server.</p>
  </div>

  <div class="mt-4 grid gap-5 sm:grid-cols-[minmax(0,17rem)_1fr]">
    <div>
      <div class="relative">
        <canvas
          class="aspect-square w-full touch-none rounded-lg bg-black ring-1 ring-line"
          width="280"
          height="280"
          aria-label="Drawing area: draw a digit from 0 to 9"
          data-umami-event="mnist-demo"
        ></canvas>
        <p data-hint class="pointer-events-none absolute inset-0 m-auto h-fit w-fit text-sm text-white/60">Draw 0–9 here</p>
      </div>
      <div class="mt-2 flex items-center justify-between gap-2">
        <button type="button" data-clear class="rounded-full border border-line px-3 py-1 text-xs font-medium text-fg-muted hover:border-accent hover:text-fg">Clear</button>
        <span class="flex items-center gap-2 text-[11px] text-fg-faint">
          What the model sees
          <canvas data-preview width="28" height="28" class="h-10 w-10 rounded bg-black ring-1 ring-line [image-rendering:pixelated]"></canvas>
        </span>
      </div>
    </div>

    <div class="min-w-0">
      <p class="text-[11px] font-medium tracking-wide text-fg-faint uppercase">Prediction</p>
      <p class="font-mono text-4xl font-semibold" data-pred aria-live="polite">–</p>
      <ul class="mt-3 space-y-1 font-mono text-xs" data-probs>
        {
          Array.from({ length: 10 }, (_, d) => (
            <li class="grid grid-cols-[1rem_1fr_3rem] items-center gap-2">
              <span class="text-fg-muted">{d}</span>
              <span class="h-2 rounded-full bg-line">
                <span class="block h-2 rounded-full bg-fg-faint" style="width:0%" />
              </span>
              <span class="text-right text-fg-faint" data-pct>0%</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-xs leading-snug text-fg-faint" data-status>
        Your drawing is cropped, scaled to 20 px and centred by mass, like the MNIST originals.
      </p>
    </div>
  </div>
</section>

<script>
  import { MnistNet, softmax, toMnist } from '../scripts/mnist';

  for (const root of document.querySelectorAll<HTMLElement>('.mnist-demo')) {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas[aria-label]')!;
    const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    const preview = root.querySelector<HTMLCanvasElement>('[data-preview]')!;
    const pctx = preview.getContext('2d')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const predEl = root.querySelector('[data-pred]')!;
    const statusEl = root.querySelector('[data-status]')!;
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-probs] li'));

    let net: MnistNet | null = null;
    let loading: Promise<void> | null = null;
    let drawing = false;
    let last: [number, number] | null = null;
    let pending = false;

    const load = () =>
      (loading ??= fetch('/models/mnist-cnn.bin')
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.arrayBuffer();
        })
        .then((b) => {
          net = new MnistNet(b);
        })
        .catch(() => {
          loading = null;
          statusEl.textContent = 'Couldn’t load the model weights. Draw again to retry.';
        }));

    function clear() {
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      pctx.clearRect(0, 0, 28, 28);
      predEl.textContent = '–';
      rows.forEach((li) => {
        li.querySelector<HTMLElement>('span > span')!.style.width = '0%';
        li.querySelector('[data-pct]')!.textContent = '0%';
      });
      hint.hidden = false;
    }

    function classify() {
      pending = false;
      if (!net) return;
      const { data } = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const ink = new Float32Array(canvas.width * canvas.height);
      for (let i = 0; i < ink.length; i++) ink[i] = data[i * 4] / 255;
      const x = toMnist(ink, canvas.width, canvas.height);
      if (!x) return;
      const img = pctx.createImageData(28, 28);
      x.forEach((v, i) => {
        const g = Math.round(v * 255);
        img.data.set([g, g, g, 255], i * 4);
      });
      pctx.putImageData(img, 0, 0);
      const p = softmax(net.logits(x));
      const best = p.indexOf(Math.max(...p));
      predEl.textContent = String(best);
      rows.forEach((li, d) => {
        const bar = li.querySelector<HTMLElement>('span > span')!;
        bar.style.width = `${(p[d] * 100).toFixed(1)}%`;
        bar.classList.toggle('bg-accent', d === best);
        bar.classList.toggle('bg-fg-faint', d !== best);
        li.querySelector('[data-pct]')!.textContent = `${Math.round(p[d] * 100)}%`;
      });
    }

    const schedule = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(classify);
    };

    const point = (e: PointerEvent): [number, number] => {
      const r = canvas.getBoundingClientRect();
      return [((e.clientX - r.left) * canvas.width) / r.width, ((e.clientY - r.top) * canvas.height) / r.height];
    };

    canvas.addEventListener('pointerdown', (e) => {
      drawing = true;
      hint.hidden = true;
      canvas.setPointerCapture(e.pointerId);
      last = point(e);
      if (!net) {
        statusEl.textContent = 'Loading the model (1.6 MB)…';
        load()?.then(() => {
          if (net) {
            statusEl.textContent = 'Your drawing is cropped, scaled to 20 px and centred by mass, like the MNIST originals.';
            schedule();
          }
        });
      }
      stroke(last);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!drawing) return;
      stroke(point(e));
    });
    const end = () => {
      drawing = false;
      last = null;
      schedule();
    };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    function stroke(p: [number, number]) {
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 22;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.beginPath();
      ctx.moveTo(...(last ?? p));
      ctx.lineTo(...p);
      ctx.stroke();
      last = p;
      schedule();
    }

    root.querySelector('[data-clear]')!.addEventListener('click', clear);
    clear();
  }
</script>
