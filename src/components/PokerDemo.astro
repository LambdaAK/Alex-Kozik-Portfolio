---
// Live demo: play heads-up Leduc poker against the CFR strategy (28 KB table, loaded on click).
---

<section class="poker-demo mt-8 rounded-xl border border-line bg-bg-elev p-4 sm:p-5" aria-labelledby="poker-demo-title">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="poker-demo-title" class="font-display text-xl font-semibold">Play against the CFR bot</h2>
    <p class="text-xs text-fg-faint">Six-card Leduc hold'em. Seats alternate every hand.</p>
  </div>

  <div data-table class="mt-4 rounded-lg bg-bg p-4 ring-1 ring-line">
    <div class="grid grid-cols-3 items-start gap-3 text-center">
      <div>
        <p class="text-[11px] font-medium tracking-wide text-fg-faint uppercase">Bot</p>
        <div data-bot-card class="card mx-auto mt-1"></div>
      </div>
      <div>
        <p class="text-[11px] font-medium tracking-wide text-fg-faint uppercase">Board</p>
        <div data-board-card class="card mx-auto mt-1"></div>
        <p class="mt-2 font-mono text-sm text-fg-muted">pot <span data-pot>0</span></p>
      </div>
      <div>
        <p class="text-[11px] font-medium tracking-wide text-fg-faint uppercase">You</p>
        <div data-my-card class="card mx-auto mt-1"></div>
      </div>
    </div>

    <p data-msg class="mt-4 min-h-[2.5rem] text-center text-sm text-fg" aria-live="polite"></p>

    <div data-actions class="mt-2 flex flex-wrap justify-center gap-2">
      <button type="button" data-start class="rounded-full bg-fg px-5 py-2 text-sm font-semibold text-bg hover:opacity-85" data-umami-event="poker-demo">
        ▶ Deal a hand
      </button>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-fg-muted">
    <span>Hands <span data-hands class="font-mono">0</span> · Your net <span data-net class="font-mono">+0</span> chips</span>
    <span class="text-fg-faint">Perfect play would net about ±0.05 chips/hand, depending on seat.</span>
  </div>

  <details class="mt-3 text-xs text-fg-muted">
    <summary class="cursor-pointer hover:text-fg">Rules</summary>
    <p class="mt-2 leading-relaxed">
      Deck of six cards (J, Q, K, two of each). Each player antes 1 and gets one private card. First betting round: bets
      are 1 chip. Then one board card is revealed and there's a second round with bets of 2. At most one raise per round.
      At showdown, pairing the board wins; otherwise the higher card wins; equal cards split.
    </p>
  </details>
</section>

<style>
  .card {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 4.5rem;
    border-radius: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    border: 1px dashed var(--color-line);
    color: var(--color-fg-faint);
  }
  .card[data-face] {
    border: 1px solid var(--color-line);
    background: #fff;
    color: #18181b;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
  }
  .card[data-face][data-red] {
    color: #e11d48;
  }
  .card[data-back] {
    border: 1px solid var(--color-line);
    background: repeating-linear-gradient(45deg, var(--color-accent-soft), var(--color-accent-soft) 6px, var(--color-bg-elev) 6px, var(--color-bg-elev) 12px);
  }
</style>

<script>
  import { newHand, apply, payoff, legalActions, strategy, sample, deal, rankOf, RANKS, type LeducState, type Policy, type Action } from '../scripts/leduc';

  for (const root of document.querySelectorAll<HTMLElement>('.poker-demo')) {
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const actionsEl = $('[data-actions]');
    const msg = $('[data-msg]');
    let policy: Policy | null = null;
    let s: LeducState | null = null;
    let me: 0 | 1 = 1;
    let hands = 0;
    let net = 0;
    let log: string[] = [];

    const LABEL: Record<Action, string> = { check: 'Check', bet: 'Bet', call: 'Call', raise: 'Raise', fold: 'Fold' };
    const PAST: Record<Action, string> = { check: 'checks', bet: 'bets', call: 'calls', raise: 'raises', fold: 'folds' };

    function showCard(el: HTMLElement, card: number | null, hidden = false) {
      el.removeAttribute('data-face');
      el.removeAttribute('data-back');
      el.removeAttribute('data-red');
      el.textContent = '';
      if (card === null) return;
      if (hidden) {
        el.setAttribute('data-back', '');
        return;
      }
      el.setAttribute('data-face', '');
      if (card % 2) el.setAttribute('data-red', '');
      el.textContent = RANKS[rankOf(card)] + (card % 2 ? '♥' : '♠');
    }

    function render() {
      if (!s) return;
      const bot = (1 - me) as 0 | 1;
      showCard($('[data-my-card]'), s.cards[me]);
      showCard($('[data-bot-card]'), s.cards[bot], !(s.done && s.folded === null));
      showCard($('[data-board-card]'), s.round === 1 || (s.done && s.folded === null) ? s.board : null);
      $('[data-pot]').textContent = String(s.contrib[0] + s.contrib[1]);
      msg.textContent = log.slice(-2).join(' ');
      actionsEl.replaceChildren();
      if (s.done) {
        const [p0, p1] = payoff(s);
        const mine = me === 0 ? p0 : p1;
        const end = s.folded === me ? 'You fold.' : s.folded !== null ? 'Bot folds.' : `Showdown: bot has ${RANKS[rankOf(s.cards[bot])]}.`;
        msg.textContent = `${end} ${mine > 0 ? `You win ${mine}` : mine < 0 ? `You lose ${-mine}` : 'Split pot'}${mine ? ` chip${Math.abs(mine) === 1 ? '' : 's'}` : ''}.`;
        actionsEl.append(button('Next hand', startHand, true));
        return;
      }
      if (s.toAct === me) {
        for (const a of legalActions(s)) actionsEl.append(button(LABEL[a], () => act(a)));
      }
    }

    function button(label: string, onClick: () => void, primary = false) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = label;
      b.className = primary
        ? 'rounded-full bg-fg px-5 py-2 text-sm font-semibold text-bg hover:opacity-85'
        : 'rounded-full border border-line px-4 py-2 text-sm font-medium text-fg hover:border-accent';
      b.addEventListener('click', onClick);
      return b;
    }

    function act(a: Action) {
      if (!s) return;
      s = apply(s, a);
      log = [`You ${PAST[a].replace(/s$/, '')}.`];
      afterMove();
    }

    function afterMove() {
      if (!s) return;
      if (s.done) {
        hands++;
        net += payoff(s)[me];
        $('[data-hands]').textContent = String(hands);
        $('[data-net]').textContent = (net >= 0 ? '+' : '') + net;
      }
      render();
      if (!s.done && s.toAct !== me) setTimeout(botMove, 650);
    }

    function botMove() {
      if (!s || !policy || s.done) return;
      const probs = strategy(policy, s);
      const a = sample(probs);
      const p = probs.find(([x]) => x === a)![1];
      s = apply(s, a);
      log.push(`Bot ${PAST[a]} (it does this ${Math.round(p * 100)}% of the time here).`);
      afterMove();
    }

    function startHand() {
      const { cards, board } = deal();
      me = (1 - me) as 0 | 1;
      s = newHand(cards, board);
      log = [me === 0 ? 'You act first this hand.' : 'Bot acts first this hand.'];
      afterMove();
    }

    $('[data-start]').addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Loading…';
      try {
        const res = await fetch('/models/leduc-cfr.json');
        if (!res.ok) throw new Error(String(res.status));
        policy = await res.json();
        startHand();
      } catch {
        btn.disabled = false;
        btn.textContent = 'Couldn’t load the strategy. Retry';
      }
    });
  }
</script>
