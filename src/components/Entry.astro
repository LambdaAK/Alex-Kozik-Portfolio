---
// A featured project as an Apple-style tile: headline and one line on top, links,
// then the figure filling the bottom of the tile.
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import { demos } from '../data/demos';

interface Props {
  project: CollectionEntry<'projects'>;
  n: number;
}
const { project } = Astro.props;
const { title, tagline, date, github, website, media, mediaAlt, video, results } = project.data;
const href = `/projects/${project.id}/`;
const demo = demos[project.id];
const headline = results[0];
---

<article class="frame flex flex-col overflow-hidden" data-reveal>
  <div class="px-6 pt-6 text-center sm:px-8 sm:pt-7">
    <p class="label">{date}</p>
    <h3 class="mt-0.5 text-2xl font-semibold tracking-[-0.03em] sm:text-3xl">
      <a href={href} class="hover:opacity-80">{title}</a>
    </h3>
    {
      headline && (
        <p class="mt-1.5 font-medium text-fg">
          {headline.value} <span class="text-fg-muted">{headline.metric}</span>
        </p>
      )
    }
    <p class="mx-auto mt-3 max-w-md text-[15px] leading-relaxed text-fg-muted">{tagline}</p>
    <p class="mt-4 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[15px]">
      {
        demo && (
          <a
            href={`${href}#demo`}
            class="btn-gloss rounded-full px-4 py-1.5 font-medium"
            data-umami-event="demo-open"
            data-umami-event-project={title}
          >
            {demo}
          </a>
        )
      }
      <a href={href} class="more" data-umami-event="project-open" data-umami-event-project={title}>Learn more ›</a>
      {website && <a href={website} class="more" target="_blank" rel="noopener">Website ›</a>}
      {!demo && github && <a href={github} class="more" target="_blank" rel="noopener" data-umami-event="source" data-umami-event-project={title}>Source ›</a>}
    </p>
  </div>
  {
    media && (
      <a href={demo ? `${href}#demo` : href} class="mt-5 block px-5 pb-5" aria-label={`${title}: details`}>
        <ProjectMedia media={media} video={video} alt={mediaAlt} width={760} class="aspect-[16/10] w-full rounded-2xl bg-bg object-contain p-2" />
      </a>
    )
  }
</article>
