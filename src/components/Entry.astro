---
// A featured project as a drawing sheet: figure on top, a title block underneath with
// the headline numbers and links.
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import { demos } from '../data/demos';

interface Props {
  project: CollectionEntry<'projects'>;
  n: number;
}
const { project, n } = Astro.props;
const { title, tagline, date, github, website, media, mediaAlt, video, results } = project.data;
const href = `/projects/${project.id}/`;
const demo = demos[project.id];
---

<article class="frame flex flex-col">
  {
    media && (
      <a href={demo ? `${href}#demo` : href} class="block border-b border-line bg-bg p-3" aria-label={`${title}: details`}>
        <ProjectMedia media={media} video={video} alt={mediaAlt} width={720} class="aspect-[16/10] w-full object-contain" />
      </a>
    )
  }
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="text-xl font-semibold tracking-tight">
        <span class="label mr-2 text-accent">{String(n).padStart(2, '0')}</span>
        <a href={href} class="hover:text-accent">{title}</a>
      </h3>
      <span class="label shrink-0">{date}</span>
    </div>
    <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">{tagline}</p>

    {
      results.length > 0 && (
        <dl class="mt-4 grid grid-cols-2 border-t border-line pt-3">
          {results.slice(0, 2).map((r) => (
            <div>
              <dd class="font-mono text-[15px] font-medium text-fg">{r.value}</dd>
              <dt class="label">{r.metric}</dt>
            </div>
          ))}
        </dl>
      )
    }

    <p class="label mt-auto flex flex-wrap gap-x-5 gap-y-1 pt-4">
      {
        demo && (
          <a href={`${href}#demo`} class="font-medium text-accent hover:underline" data-umami-event="demo-open" data-umami-event-project={title}>
            ▶ {demo}
          </a>
        )
      }
      <a href={href} class="hover:text-fg" data-umami-event="project-open" data-umami-event-project={title}>Details →</a>
      {website && <a href={website} class="hover:text-fg" target="_blank" rel="noopener">Website ↗</a>}
      {github && <a href={github} class="hover:text-fg" target="_blank" rel="noopener" data-umami-event="source" data-umami-event-project={title}>Source ↗</a>}
    </p>
  </div>
</article>
