---
// A featured project on glass: date, name, one number, one line, a couple of quiet links,
// then the figure.
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import { demos } from '../data/demos';

interface Props {
  project: CollectionEntry<'projects'>;
  n: number;
}
const { project } = Astro.props;
const { title, tagline, date, github, website, media, mediaAlt, video, results } = project.data;
const href = `/projects/${project.id}/`;
const demo = demos[project.id];
const headline = results[0];
---

<article class="frame flex flex-col overflow-hidden" data-reveal>
  <div class="px-6 pt-6 sm:px-7 sm:pt-7">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="text-2xl font-semibold tracking-[-0.03em]">
        <a href={href} class="hover:opacity-75">{title}</a>
      </h3>
      <span class="label shrink-0">{date}</span>
    </div>
    {
      headline && (
        <p class="mt-1 text-[15px] text-fg">
          {headline.value} <span class="text-fg-muted">{headline.metric}</span>
        </p>
      )
    }
    <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">{tagline}</p>
    <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[15px]">
      {
        demo && (
          <a href={`${href}#demo`} class="pill" data-umami-event="demo-open" data-umami-event-project={title}>
            ▶ {demo}
          </a>
        )
      }
      <a href={href} class="more" data-umami-event="project-open" data-umami-event-project={title}>details →</a>
      {website && <a href={website} class="more" target="_blank" rel="noopener">website ↗</a>}
      {github && <a href={github} class="more" target="_blank" rel="noopener" data-umami-event="source" data-umami-event-project={title}>source ↗</a>}
    </p>
  </div>
  {
    media && (
      <a href={demo ? `${href}#demo` : href} class="mt-5 block px-4 pb-4" aria-label={`${title}: details`}>
        <ProjectMedia media={media} video={video} alt={mediaAlt} width={760} class="aspect-[16/10] w-full rounded-2xl bg-bg-elev/80 object-contain p-2" />
      </a>
    )
  }
</article>
