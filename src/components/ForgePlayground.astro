---
// Live Forge playground: the real lexer, parser, macro expander, Hindley–Milner type checker
// and interpreter, compiled from OCaml to JavaScript (js_of_ocaml) and run in a Web Worker.
const files = import.meta.glob('../data/forge-examples/*.forge', { query: '?raw', import: 'default', eager: true });
const LABELS: Record<string, string> = {
  '01-inference': 'Type inference',
  '02-adts': 'ADTs',
  '03-higher-order': 'Folds',
  '04-traits': 'Traits',
  '05-macros': 'Macros',
  '06-type-error': 'Type error',
  '07-infinite-loop': 'Infinite loop',
};
const examples = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, source]) => {
    const id = path.split('/').pop()!.replace('.forge', '');
    return { id, label: LABELS[id] ?? id, source: source as string };
  });
---

<section class="forge-playground mt-8 rounded-xl border border-line bg-bg-elev p-4 sm:p-5" aria-labelledby="forge-pg-title" id="playground">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="forge-pg-title" class="font-display text-xl font-semibold">Try Forge in your browser</h2>
    <p class="text-xs text-fg-faint">The real type checker and interpreter, compiled from OCaml to JS (339 KB). No server.</p>
  </div>

  <div class="mt-3 flex flex-wrap gap-1.5" role="tablist" aria-label="Examples">
    {
      examples.map((ex, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-example={ex.id}
          class="rounded-full border border-line px-3 py-1 text-xs font-medium text-fg-muted transition hover:border-accent hover:text-fg aria-selected:border-accent aria-selected:bg-accent-soft aria-selected:text-fg"
        >
          {ex.label}
        </button>
      ))
    }
  </div>

  <div class="mt-3 grid gap-3 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
    <div class="flex flex-col">
      <textarea
        data-editor
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        aria-label="Forge source code"
        class="h-80 w-full resize-y rounded-lg bg-[#0b0f14] p-3 font-mono text-[12.5px] leading-relaxed text-[#e6e8eb] ring-1 ring-line outline-none focus:ring-accent"
      >{examples[0].source}</textarea>
      <div class="mt-2 flex items-center gap-3">
        <button type="button" data-run class="rounded-full bg-fg px-5 py-1.5 text-sm font-semibold text-bg hover:opacity-85" data-umami-event="forge-playground">
          ▶ Run
        </button>
        <span class="text-xs text-fg-faint">⌘/Ctrl + Enter</span>
        <span class="ml-auto font-mono text-xs text-fg-faint" data-status></span>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-3">
      <div>
        <p class="text-[11px] font-medium tracking-wide text-fg-faint uppercase">Output</p>
        <pre data-output class="mt-1 max-h-40 min-h-[4.5rem] overflow-auto rounded-lg bg-bg p-3 font-mono text-[12.5px] leading-relaxed whitespace-pre-wrap text-fg ring-1 ring-line">Press Run.</pre>
      </div>
      <div>
        <p class="text-[11px] font-medium tracking-wide text-fg-faint uppercase">Inferred types</p>
        <ul data-types class="mt-1 max-h-48 space-y-0.5 overflow-auto rounded-lg bg-bg p-3 font-mono text-[12px] leading-relaxed ring-1 ring-line"></ul>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ examples }} is:inline>
  window.__forgeExamples = examples;
</script>

<script>
  type Result = { ok: boolean; output: string; error?: string; bindings?: { name: string; type: string; value: string }[]; ms: number };
  const examples = (window as unknown as { __forgeExamples: { id: string; source: string }[] }).__forgeExamples;

  for (const root of document.querySelectorAll<HTMLElement>('.forge-playground')) {
    const editor = root.querySelector<HTMLTextAreaElement>('[data-editor]')!;
    const runBtn = root.querySelector<HTMLButtonElement>('[data-run]')!;
    const out = root.querySelector<HTMLElement>('[data-output]')!;
    const types = root.querySelector<HTMLElement>('[data-types]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-example]'));

    let worker: Worker | null = null;
    let watchdog = 0;
    let running = false;

    const freshWorker = () => {
      worker?.terminate();
      worker = new Worker('/forge/worker.js');
      worker.onmessage = (e: MessageEvent<Result>) => done(e.data);
      worker.onerror = () => done({ ok: false, output: '', error: 'The Forge runtime failed to load.', ms: 0 });
    };

    function done(r: Result) {
      clearTimeout(watchdog);
      running = false;
      runBtn.disabled = false;
      runBtn.textContent = '▶ Run';
      out.textContent = '';
      if (r.output) out.append(r.output.replace(/\n$/, ''));
      if (r.error) {
        const err = document.createElement('span');
        err.className = 'text-[#e11d48]';
        err.textContent = (r.output ? '\n' : '') + r.error.replace(/^Other error: /, '');
        out.append(err);
      }
      if (!r.output && !r.error) out.textContent = '(no output)';
      types.replaceChildren(
        ...(r.bindings ?? [])
          .filter((b) => b.name !== '()' && b.name !== '-')
          .map((b) => {
            const li = document.createElement('li');
            const name = document.createElement('span');
            name.className = 'text-accent';
            name.textContent = b.name;
            li.append(name, ` : ${b.type}`);
            return li;
          }),
      );
      if (!types.children.length) types.innerHTML = '<li class="text-fg-faint">–</li>';
      status.textContent = r.ms ? `${r.ok ? 'ok' : 'error'} · ${r.ms} ms` : '';
    }

    function run() {
      if (running) return;
      if (!worker) freshWorker();
      running = true;
      runBtn.disabled = true;
      runBtn.textContent = 'Running…';
      status.textContent = '';
      worker!.postMessage({ source: editor.value });
      // The interpreter has its own step limit; this is a backstop.
      watchdog = window.setTimeout(() => {
        freshWorker();
        done({ ok: false, output: '', error: 'Stopped after 15 s.', ms: 0 });
      }, 15000);
    }

    runBtn.addEventListener('click', run);
    editor.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        run();
      } else if (e.key === 'Tab') {
        e.preventDefault();
        editor.setRangeText('  ', editor.selectionStart, editor.selectionEnd, 'end');
      }
    });
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        editor.value = examples.find((x) => x.id === tab.dataset.example)!.source;
        out.textContent = 'Press Run.';
        types.replaceChildren();
        status.textContent = '';
      }),
    );
  }
</script>
