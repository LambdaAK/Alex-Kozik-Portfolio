---
// An organization's logo, unframed on a transparent background. Uses `dark` in dark mode
// when the regular logo has dark lettering.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  dark?: ImageMetadata;
}
const { src, dark } = Astro.props;
const cls = 'h-12 w-12 shrink-0 object-contain';
---

<Image src={src} alt="" width={96} height={96} class={dark ? `${cls} dark:hidden` : cls} />
{dark && <Image src={dark} alt="" width={96} height={96} class={`${cls} hidden dark:block`} />}
