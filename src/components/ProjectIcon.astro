---
// Square project icon, or a monogram tile when a project has no logo.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  title: string;
  size: number;
  class?: string;
}
const { image, title, size, class: className = '' } = Astro.props;
const initials = title
  .split(/[\s-]+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

{
  image ? (
    <Image src={image} alt="" width={size * 2} height={size * 2} class={`object-cover ${className}`} />
  ) : (
    <span
      class={`flex items-center justify-center bg-accent-soft font-display font-semibold text-accent dark:text-fg ${className}`}
      aria-hidden="true"
    >
      {initials}
    </span>
  )
}
