---
// Courses as an aligned list: code in a column sized to the longest code, then the name,
// then a small tag from a trailing "(…)" such as "grad" or "Fall 2024".
interface Props {
  items: string[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;

const split = (c: string) => {
  const m = c.match(/^([A-Z]+ \d{4}(?:\/\d{4})?|\d{2}-\d{3})\s+(.*?)(?:\s+\((.+)\))?$/);
  return m ? { code: m[1], name: m[2], tag: m[3] } : { code: '', name: c, tag: undefined };
};
---

<ul class={`grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm ${className}`}>
  {
    items.map((c) => {
      const { code, name, tag } = split(c);
      return (
        <li class="contents">
          <span class="whitespace-nowrap text-fg-faint tabular-nums">{code}</span>
          <span class="text-fg-muted">
            {name}
            {tag && <span class="ml-1.5 text-xs whitespace-nowrap text-fg-faint">{tag}</span>}
          </span>
        </li>
      );
    })
  }
</ul>
