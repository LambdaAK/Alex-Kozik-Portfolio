---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import TechChips from './TechChips.astro';
import type { Experience } from '../data/experience';

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

<ol class="space-y-8">
  {
    items.map((e) => (
      <li class="grid gap-3 sm:grid-cols-[7.5rem_1fr] sm:gap-6">
        <div class="text-xs font-medium tracking-wide text-fg-faint uppercase sm:pt-1">
          {e.dates}
        </div>
        <div>
          <div class="flex items-center gap-4">
            <Image
              src={e.logo}
              alt=""
              width={112}
              height={112}
              class="h-12 w-12 shrink-0 rounded-lg bg-white object-contain p-1 ring-1 ring-line sm:h-14 sm:w-14"
            />
            <div>
              <h3 class="font-semibold leading-snug">{e.role}</h3>
              <p class="text-sm text-fg-muted">
                {e.url ? (
                  <a href={e.url} class="hover:text-accent" target="_blank" rel="noopener">
                    {e.company}
                  </a>
                ) : (
                  e.company
                )}
              </p>
            </div>
          </div>
          <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-fg-muted">
            {e.bullets.map((b) => (
              <li class="flex gap-2">
                <span class="mt-[0.6em] h-1 w-1 shrink-0 rounded-full bg-fg-faint" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
          {e.links && (
            <div class="mt-2 flex flex-wrap gap-x-4 text-sm font-medium text-fg-muted">
              {e.links.map((l) => (
                <a href={l.href} class="inline-flex items-center gap-1 hover:text-accent" target="_blank" rel="noopener" data-umami-event="report" data-umami-event-project={e.company}>
                  <Icon name="file" class="h-3.5 w-3.5" /> {l.label}
                </a>
              ))}
            </div>
          )}
          <TechChips items={e.tech} class="mt-3" />
        </div>
      </li>
    ))
  }
</ol>
