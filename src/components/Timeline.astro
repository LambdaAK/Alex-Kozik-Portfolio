---
// Compact notebook rows: role and company in the column, dates in the margin,
// bullets and links folded into a <details>.
import type { Experience } from '../data/experience';

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

<ol class="divide-y divide-line border-y border-line">
  {
    items.map((e) => (
      <li class="grid gap-x-10 py-3 lg:grid-cols-[minmax(0,42rem)_11rem]">
        <details class="group min-w-0">
          <summary class="flex cursor-pointer list-none items-baseline gap-3">
            <span class="label w-4 shrink-0 transition group-open:rotate-90 group-open:text-accent">›</span>
            <span class="min-w-0">
              <span class="text-fg">{e.role}</span>
              <span class="text-fg-muted">
                {' — '}
                {e.company}
              </span>
            </span>
          </summary>
          <div class="mt-2 mb-1 pl-7">
            <ul class="space-y-1.5 text-[16px] leading-relaxed text-fg-muted">
              {e.bullets.map((b) => (
                <li class="flex gap-2">
                  <span class="text-fg-faint">–</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            {e.links && (
              <p class="label mt-2 flex flex-wrap gap-x-5">
                {e.links.map((l) => (
                  <a
                    href={l.href}
                    class="text-accent hover:underline"
                    {...(l.href.startsWith('/projects/') ? {} : { target: '_blank', rel: 'noopener' })}
                    data-umami-event="link"
                    data-umami-event-project={e.company}
                  >
                    {l.label} {l.href.startsWith('/projects/') ? '→' : '↗'}
                  </a>
                ))}
              </p>
            )}
            <p class="label mt-2">{e.tech.join(' · ')}</p>
          </div>
        </details>
        <p class="label pl-7 lg:pt-1 lg:pl-0">{e.dates}</p>
      </li>
    ))
  }
</ol>
