---
// Plain rows: logo, role at company, dates; one line of what I did, the rest on click.
import { Image } from 'astro:assets';
import type { Experience } from '../data/experience';

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

<ol class="space-y-7">
  {
    items.map((e) => (
      <li class="flex gap-4">
        <Image src={e.logo} alt="" width={80} height={80} class="mt-1 h-9 w-9 shrink-0 rounded-lg bg-white object-contain p-1 ring-1 ring-black/5" />
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <p class="font-medium">
              {e.role}{' '}
              <span class="font-normal text-fg-muted">
                at{' '}
                {e.url ? (
                  <a href={e.url} class="ink" target="_blank" rel="noopener">
                    {e.company}
                  </a>
                ) : (
                  e.company
                )}
              </span>
            </p>
            <span class="text-sm text-fg-faint">{e.dates}</span>
          </div>
          <p class="mt-1 leading-relaxed text-fg-muted">{e.bullets[0]}</p>
          {(e.bullets.length > 1 || e.links) && (
            <details class="group mt-1">
              <summary class="more cursor-pointer list-none text-sm hover:text-fg">
                <span class="group-open:hidden">more</span>
                <span class="hidden group-open:inline">less</span>
              </summary>
              <ul class="mt-1.5 list-disc space-y-1 pl-5 leading-relaxed text-fg-muted marker:text-fg-faint">
                {e.bullets.slice(1).map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              {e.links && (
                <p class="mt-2 flex flex-wrap gap-x-4 text-sm">
                  {e.links.map((l) => (
                    <a
                      href={l.href}
                      class="ink"
                      {...(l.href.startsWith('/projects/') ? {} : { target: '_blank', rel: 'noopener' })}
                      data-umami-event="link"
                      data-umami-event-project={e.company}
                    >
                      {l.label}
                    </a>
                  ))}
                </p>
              )}
            </details>
          )}
        </div>
      </li>
    ))
  }
</ol>
