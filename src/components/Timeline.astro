---
// Role cards: logo, role and company, dates on the right; the first bullet is shown,
// the rest fold into "more".
import { Image } from 'astro:assets';
import type { Experience } from '../data/experience';

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

<ol class="space-y-4">
  {
    items.map((e) => (
      <li class="frame p-5">
        <div class="flex items-start gap-4">
          <Image src={e.logo} alt="" width={96} height={96} class="h-11 w-11 shrink-0 bg-white object-contain p-1 ring-1 ring-line" />
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold leading-snug">{e.role}</h3>
              <span class="label">{e.dates}</span>
            </div>
            <p class="text-fg-muted">
              {e.url ? (
                <a href={e.url} class="hover:text-accent" target="_blank" rel="noopener">
                  {e.company}
                </a>
              ) : (
                e.company
              )}
            </p>
          </div>
        </div>
        <p class="mt-3 text-[15px] leading-relaxed text-fg-muted">{e.bullets[0]}</p>
        {(e.bullets.length > 1 || e.links) && (
          <details class="group mt-2">
            <summary class="label cursor-pointer list-none text-accent hover:underline">
              <span class="group-open:hidden">+ more</span>
              <span class="hidden group-open:inline">− less</span>
            </summary>
            <ul class="mt-2 space-y-1.5 text-[15px] leading-relaxed text-fg-muted">
              {e.bullets.slice(1).map((b) => (
                <li class="flex gap-2">
                  <span class="text-accent">▪</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            {e.links && (
              <p class="label mt-2 flex flex-wrap gap-x-5">
                {e.links.map((l) => (
                  <a
                    href={l.href}
                    class="text-accent hover:underline"
                    {...(l.href.startsWith('/projects/') ? {} : { target: '_blank', rel: 'noopener' })}
                    data-umami-event="link"
                    data-umami-event-project={e.company}
                  >
                    {l.label} {l.href.startsWith('/projects/') ? '→' : '↗'}
                  </a>
                ))}
              </p>
            )}
          </details>
        )}
        <p class="label mt-3">{e.tech.join(' · ')}</p>
      </li>
    ))
  }
</ol>
