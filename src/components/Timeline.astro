---
// Role tiles: logo, role, company and dates; the first bullet is shown, the rest fold away.
import { Image } from 'astro:assets';
import type { Experience } from '../data/experience';

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

<ol class="grid items-start gap-3 md:grid-cols-2">
  {
    items.map((e) => (
      <li class="frame p-5" data-reveal>
        <div class="flex items-center gap-4">
          <Image src={e.logo} alt="" width={112} height={112} class="h-10 w-10 shrink-0 rounded-xl bg-white object-contain p-1.5 shadow-[0_0_0_1px_rgba(0,0,0,0.06)]" />
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold leading-snug tracking-[-0.01em]">{e.role}</h3>
              <span class="label">{e.dates}</span>
            </div>
            <p class="text-fg-muted">
              {e.url ? (
                <a href={e.url} class="hover:text-accent" target="_blank" rel="noopener">
                  {e.company}
                </a>
              ) : (
                e.company
              )}
            </p>
          </div>
        </div>
        <p class="mt-3 text-[15px] leading-relaxed text-fg-muted">{e.bullets[0]}</p>
        {(e.bullets.length > 1 || e.links) && (
          <details class="group mt-2">
            <summary class="more cursor-pointer list-none text-[15px]">
              <span class="group-open:hidden">more</span>
              <span class="hidden group-open:inline">less</span>
            </summary>
            <ul class="mt-2 list-disc space-y-1.5 pl-5 text-[15px] leading-relaxed text-fg-muted">
              {e.bullets.slice(1).map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            {e.links && (
              <p class="mt-3 flex flex-wrap gap-x-5 text-[15px]">
                {e.links.map((l) => (
                  <a
                    href={l.href}
                    class="more"
                    {...(l.href.startsWith('/projects/') ? {} : { target: '_blank', rel: 'noopener' })}
                    data-umami-event="link"
                    data-umami-event-project={e.company}
                  >
                    {l.label} →
                  </a>
                ))}
              </p>
            )}
          </details>
        )}
      </li>
    ))
  }
</ol>
