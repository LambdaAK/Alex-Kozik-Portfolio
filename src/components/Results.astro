---
// Headline numbers, each next to what it's compared against.
interface Props {
  results: { metric: string; value: string; baseline?: string }[];
  class?: string;
}
const { results, class: className = '' } = Astro.props;
---

{
  results.length > 0 && (
    <dl class={`grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-3 ${className}`}>
      {results.map((r) => (
        <div class="bg-bg-elev px-3 py-2">
          <dt class="text-[11px] font-medium tracking-wide text-fg-faint uppercase">{r.metric}</dt>
          <dd class="mt-0.5 font-mono text-sm font-semibold text-fg">{r.value}</dd>
          {r.baseline && <dd class="text-xs leading-snug text-fg-muted">{r.baseline}</dd>}
        </div>
      ))}
    </dl>
  )
}
