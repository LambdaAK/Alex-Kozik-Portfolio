---
// Page background: a drifting, monochrome point cloud that looks like an embedding plot. Points follow noisy (Langevin-style) dynamics toward three slowly moving
// cluster centers, nearby points are joined by faint lines, and the cursor pushes them aside.
// Static frame under prefers-reduced-motion; pauses when the tab is hidden.
---

<div class="field pointer-events-none absolute inset-x-0 top-0 -z-10 h-[70vh] overflow-hidden [mask-image:linear-gradient(to_bottom,black_30%,transparent)]" aria-hidden="true">
  <canvas class="absolute inset-0 h-full w-full"></canvas>
</div>


<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.field canvas')!;
  const ctx = canvas.getContext('2d')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const N = innerWidth < 640 ? 60 : 120;
  const LINK = 90;

  type P = { x: number; y: number; vx: number; vy: number; c: number };
  let w = 0;
  let h = 0;
  let pts: P[] = [];
  let mouse = { x: -1e4, y: -1e4 };
  let t = Math.random() * 1000;

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    w = innerWidth;
    h = canvas.clientHeight || innerHeight * 0.7;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (!pts.length) {
      pts = Array.from({ length: N }, (_, i) => ({ x: Math.random() * w, y: Math.random() * h, vx: 0, vy: 0, c: i % 3 }));
    }
  }

  // Three cluster centers trace slow Lissajous curves.
  const center = (c: number) => ({
    x: w * (0.5 + 0.32 * Math.sin(t * 0.00011 * (c + 1) + c * 2.1)),
    y: h * (0.5 + 0.3 * Math.cos(t * 0.00009 * (c + 2) + c * 1.3)),
  });

  function step() {
    const centers = [0, 1, 2].map(center);
    for (const p of pts) {
      const k = centers[p.c];
      // Weak pull toward the cluster, Gaussian-ish noise, friction.
      p.vx += (k.x - p.x) * 0.00002 + (Math.random() - 0.5) * 0.06;
      p.vy += (k.y - p.y) * 0.00002 + (Math.random() - 0.5) * 0.06;
      const dx = p.x - mouse.x;
      const dy = p.y - mouse.y;
      const d2 = dx * dx + dy * dy;
      if (d2 < 140 * 140) {
        const f = (1 - Math.sqrt(d2) / 140) * 0.35;
        p.vx += (dx / (Math.sqrt(d2) + 1)) * f;
        p.vy += (dy / (Math.sqrt(d2) + 1)) * f;
      }
      p.vx *= 0.96;
      p.vy *= 0.96;
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < -20) p.x = w + 20;
      if (p.x > w + 20) p.x = -20;
      if (p.y < -20) p.y = h + 20;
      if (p.y > h + 20) p.y = -20;
    }
  }

  function draw() {
    const dark = document.documentElement.classList.contains('dark');
    const ink = dark ? '217 119 87' : '201 100 66';
    const a = dark ? 0.22 : 0.14;
    ctx.clearRect(0, 0, w, h);
    ctx.lineWidth = 1;
    for (let i = 0; i < pts.length; i++) {
      for (let j = i + 1; j < pts.length; j++) {
        const p = pts[i];
        const q = pts[j];
        const dx = p.x - q.x;
        const dy = p.y - q.y;
        const d2 = dx * dx + dy * dy;
        if (d2 > LINK * LINK) continue;
        ctx.strokeStyle = `rgb(${ink} / ${(1 - Math.sqrt(d2) / LINK) * (dark ? 0.08 : 0.05)})`;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(q.x, q.y);
        ctx.stroke();
      }
    }
    for (const p of pts) {
      ctx.fillStyle = `rgb(${ink} / ${a})`;
      ctx.beginPath();
      ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  let last = 0;
  let raf = 0;
  function loop(now: number) {
    raf = requestAnimationFrame(loop);
    if (now - last < 33) return; // ~30 fps is plenty
    last = now;
    t += 33;
    step();
    draw();
  }

  resize();
  addEventListener('resize', () => {
    resize();
    if (still) draw();
  });
  addEventListener('pointermove', (e) => {
    mouse = { x: e.clientX, y: e.clientY + scrollY };
  });
  addEventListener('pointerleave', () => (mouse = { x: -1e4, y: -1e4 }));
  new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  if (still) {
    for (let i = 0; i < 400; i++) step();
    draw();
  } else {
    raf = requestAnimationFrame(loop);
    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) raf = requestAnimationFrame(loop);
    });
  }
</script>
