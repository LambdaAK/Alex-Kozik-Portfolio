---
// A section with a large, tight Apple-style headline.
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}
const { id, title, subtitle } = Astro.props;
---

<section id={id} class="scroll-mt-14 pt-24 sm:pt-32" aria-labelledby={`${id}-title`}>
  <div class="mb-8 sm:mb-10" data-reveal>
    <h2 id={`${id}-title`} class="text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{title}</h2>
    {subtitle && <p class="mt-3 max-w-2xl text-lg text-fg-muted sm:text-xl">{subtitle}</p>}
  </div>
  <slot />
</section>
