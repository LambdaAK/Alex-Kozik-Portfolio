---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}
const { id, title, subtitle } = Astro.props;
---

<section id={id} class="scroll-mt-16 py-12 lg:scroll-mt-0 lg:py-16" aria-labelledby={`${id}-title`}>
  <h2
    id={`${id}-title`}
    class="mb-6 text-xs font-semibold tracking-[0.18em] text-fg uppercase"
  >
    {title}
  </h2>
  {subtitle && <p class="-mt-3 mb-6 text-sm text-fg-muted">{subtitle}</p>}
  <slot />
</section>
