---
// A notebook section: a mono section mark and title over a hairline.
interface Props {
  id: string;
  title: string;
  mark?: string;
}
const { id, title, mark } = Astro.props;
---

<section id={id} class="scroll-mt-8 pt-16 lg:pt-20" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="label mb-6 flex items-baseline gap-3 tracking-[0.12em] uppercase">
    {mark && <span class="text-accent">{mark}</span>}
    <span class="text-fg-muted">{title}</span>
  </h2>
  <slot />
</section>
