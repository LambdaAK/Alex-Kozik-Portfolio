---
// A section with a large, tight Apple-style headline.
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}
const { id, title, subtitle } = Astro.props;
---

<section id={id} class="scroll-mt-14 pt-16 sm:pt-20" aria-labelledby={`${id}-title`}>
  <div class="mb-6" data-reveal>
    <h2 id={`${id}-title`} class="text-2xl font-semibold tracking-[-0.03em] sm:text-3xl">{title}</h2>
    {subtitle && <p class="mt-2 max-w-2xl text-fg-muted sm:text-lg">{subtitle}</p>}
  </div>
  <slot />
</section>
