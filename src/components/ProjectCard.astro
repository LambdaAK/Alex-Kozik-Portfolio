---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TechChips from './TechChips.astro';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'featured' | 'compact';
}
const { project, variant = 'compact' } = Astro.props;
const { title, tagline, description, tech, github, demo, paper, image } = project.data;
const href = `/projects/${project.id}/`;
---

{
  variant === 'featured' ? (
    <article class="group grid gap-4 rounded-xl border border-line bg-bg-elev p-5 transition hover:border-accent/60 sm:grid-cols-[88px_1fr] sm:gap-6">
      <a href={href} class="shrink-0" aria-hidden="true" tabindex="-1">
        <Image
          src={image}
          alt=""
          width={176}
          height={176}
          class="h-16 w-16 rounded-lg object-cover sm:h-[88px] sm:w-[88px]"
        />
      </a>
      <div class="min-w-0">
        <h3 class="text-lg font-semibold leading-snug">
          <a href={href} class="transition group-hover:text-accent">
            {title}
          </a>
        </h3>
        <p class="mt-1 text-sm font-medium text-fg">{tagline}</p>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">{description}</p>
        <TechChips items={tech} class="mt-3" />
        <ProjectLinks github={github} demo={demo} paper={paper} details={href} class="mt-3" />
      </div>
    </article>
  ) : (
    <article class="group flex gap-4 rounded-xl border border-line bg-bg-elev p-4 transition hover:border-accent/60">
      <a href={href} class="shrink-0" aria-hidden="true" tabindex="-1">
        <Image src={image} alt="" width={96} height={96} class="h-12 w-12 rounded-md object-cover" />
      </a>
      <div class="min-w-0 flex-1">
        <h3 class="font-semibold leading-snug">
          <a href={href} class="transition group-hover:text-accent">
            {title}
          </a>
        </h3>
        <p class="mt-1 text-sm leading-relaxed text-fg-muted">{tagline}</p>
        <TechChips items={tech} class="mt-2.5" />
        <ProjectLinks github={github} demo={demo} paper={paper} details={href} class="mt-2.5" />
      </div>
    </article>
  )
}
