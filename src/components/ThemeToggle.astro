---
// Text toggle in the notebook's mono voice: "night" on paper, "day" at night.
---

<button id="theme-toggle" type="button" class="label cursor-pointer transition hover:text-accent" aria-label="Toggle dark mode">
  <span class="dark:hidden">night</span>
  <span class="hidden dark:inline">day</span>
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
</script>
