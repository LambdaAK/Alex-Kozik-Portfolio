---
import Icon from './Icon.astro';
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-fg-muted transition hover:border-accent hover:text-fg"
  aria-label="Toggle dark mode"
>
  <span class="dark:hidden"><Icon name="moon" /></span>
  <span class="hidden dark:inline"><Icon name="sun" /></span>
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
</script>
