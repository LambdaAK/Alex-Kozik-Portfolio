---
import Icon from './Icon.astro';
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-7 w-7 items-center justify-center rounded-full text-fg-muted transition hover:bg-fg/5 hover:text-fg"
  aria-label="Toggle dark mode"
>
  <span class="dark:hidden"><Icon name="moon" class="h-4 w-4" /></span>
  <span class="hidden dark:inline"><Icon name="sun" class="h-4 w-4" /></span>
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
</script>
