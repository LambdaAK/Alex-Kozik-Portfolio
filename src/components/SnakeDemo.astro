---
// Live demo: self-play Battlesnake agents, running entirely in the browser (rules in JS,
// networks via ONNX Runtime Web). The 8 MB network loads on click.
// Component code is copied from github.com/LambdaAK/SnakeDQN (web/snake-demo.js).
import '../scripts/snake-selfplay/snake-demo.css';
---

<section class="snake-selfplay" data-snake-selfplay aria-label="Snake self-play demo"></section>

<script>
  import { mountSnakeDemo } from '../scripts/snake-selfplay/snake-demo.js';

  for (const root of document.querySelectorAll<HTMLElement>('[data-snake-selfplay]')) {
    mountSnakeDemo(root, { base: '/models/snake-selfplay/', autoLoad: false });
  }
</script>
